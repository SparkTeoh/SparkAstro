---
import MainLayout from "../layouts/MainLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import PartnerCard from "../components/ui/PartnerCard.astro";
import CtaCard from "../components/ui/CtaCard.astro";
import partners from "../data/partners.json";
---

<MainLayout
  title="官方合作伙伴 - Spark Liang"
  description="Spark Liang 的官方合作伙伴：价值思维学院（个人价值投资教育）与 MMC Financial（企业预算管理与 AI 财务咨询）。除此之外任何声称合作的均为假冒。"
>
  <PageHero
    eyebrow="官方合作伙伴"
    title="我只和这<em>两家</em>机构合作。"
    lede="无论是个人价值投资教育，还是企业预算管控与 AI 财务咨询，我只与自己深度参与、经过严格筛选的机构合作。除了下面两家，任何声称与我合作的个人或机构都是假冒。"
  />

  <section class="sp-wrap sp-section sp-section--alt" aria-label="合作伙伴列表">
    <div class="sp-grid sp-grid--2">
      {partners.map((p) => <PartnerCard {...p} />)}
    </div>
  </section>

  <section class="sp-wrap sp-section" aria-labelledby="why-title">
    <div class="sp-stack">
      <p class="sp-eyebrow">为什么是这两家</p>
      <h2 class="sp-h2" id="why-title">我只推荐自己长期参与、看得到真实成果的机构。</h2>
      <p class="sp-copy">无论是帮个人投资者建立长期复利系统，还是帮企业老板用 AI 与预算机制抓出利润漏洞、守住现金流，这两家机构都具备扎实的实战体系与交付口碑。</p>
    </div>
  </section>

  <CtaCard
    eyebrow="企业咨询"
    title="企业内训、AI 财务与预算机制咨询？"
    copy="除了访问上面两家的官方网站，你也可以直接通过站内合作表单预约沟通，我和核心团队会在 3 个工作日内回复。"
    cta="预约咨询 / 合作"
    href="/contact#collab"
  />
</MainLayout>
