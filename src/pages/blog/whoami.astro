---
import MainLayout from "../../layouts/MainLayout.astro";
import SectionIntro from "../../components/ui/SectionIntro.astro";
import Accordion from "../../components/ui/Accordion.astro";
import CtaCard from "../../components/ui/CtaCard.astro";
import Tags from "../../components/ui/Tags.astro";
import { formatDate } from "../../utils";

// 博客数据 - 这是必需的元数据
export const blogData = {
  title: "你是谁？ —— 从过去决定论到未来创造论的思维革命",
  pubDate: new Date('2025-09-01'),
  author: "Spark Liang",
  tags: ["自我成长", "不内耗", "个人成长系统", "思维模型", "自我认知", "哲学思考"],
  summary: "一场关于自我认知的深度探索，揭示真实自我与身份认同的区别",
  type: "深度思考",
  featured: true
};

const toc = [
  { id: "experiment", num: "01", title: "思考实验", note: "“我是谁？”" },
  { id: "lesson-1", num: "02", title: "第一课", note: "区分你和你的东西" },
  { id: "lesson-2", num: "03", title: "第二课", note: "“因为” vs “因此”" },
  { id: "lesson-3", num: "04", title: "第三课", note: "转移，不是改变" },
  { id: "insight", num: "05", title: "终极领悟", note: "我决定我是谁" },
];

// 常见的身份认同陷阱
const coreIdeas = [
  { title: "“我是我的身体”", description: "身体只是你体验世界的载具，会变化会衰老，但观察身体变化的“你”始终存在。" },
  { title: "“我是我的思维”", description: "思维如天空中的云朵来去自如，真正的你是容纳所有云朵的广阔天空。" },
  { title: "“我是我的情绪”", description: "情绪是身体里的能量流，有起有落，真正的你是感受这股能量的观察者。" },
];

// 语言转换对比
const languageShift = [
  {
    label: "过去决定论",
    type: "因为",
    description: "通往过去的单行道",
    lead: "仔细听听我们日常的抱怨：",
    examples: ["我之所以不快乐，因为我的童年不幸福。", "我之所以不敢尝试，因为我上次失败了。"],
    result: "让你陷入习得性无助，认为一切都是过去决定的。",
    positive: false,
  },
  {
    label: "未来创造论",
    type: "因此",
    description: "通往未来的创造之门",
    lead: "现在，我们来做一个思维的“换挡”。把你的焦点从过去转向你渴望的未来。",
    examples: [
      "我未来的目标是成为健康有活力的人，因此，我现在选择去健身房。",
      "我渴望建立真诚的亲密关系，因此，我现在选择学习如何更好地沟通。",
    ],
    result: "让你当下的每个行动都充满目的性，为未来投资。",
    positive: true,
  },
];

// “转移”的三个步骤
const shiftSteps = [
  { title: "接纳现状", text: "首先，我看到并接纳“我过去常常有拖延的行为”这个事实，我不评判它。" },
  { title: "选择新方向", text: "然后，我选择一个新的、更有效的行为模式。例如，“我选择转移到一种‘先完成最重要的事’的工作模式。”" },
  { title: "创造新体验", text: "最后，我开始有意识地去练习这个新的模式。" },
];

// FAQ 数据（Accordion 格式）
const faqData = [
  {
    title: "什么是“身份认同”？",
    description: "身份认同是指将自己与外在的身份、角色、情绪或思维划等号的现象。它是一种限制性思维模式，会让我们被过去的体验所束缚。真正的你远比这些更广阔。",
  },
  {
    title: "如何区分“我是”和“我拥有”？",
    description: "通过有意识地改变语言习惯，比如将“我很焦虑”改为“我正在体验焦虑的情绪”。这种语言转换能够帮助你从情绪的囚犯变成观察者，获得选择的自由。",
  },
  {
    title: "“因为”和“因此”的区别是什么？",
    description: "“因为”让你回头看过去，将现在的问题归因于过去的事件，这会导致习得性无助。而“因此”让你面向未来，基于你渴望的目标来采取行动，这是一种创造性的思维方式。",
  },
  {
    title: "怎样才能真正做到“我决定我是谁”？",
    description: "这是一个宣告的过程。不需要等待外在条件或过去经历的证明，你可以在任何时刻选择你想成为的人。这个决定本身就是你的力量源泉。",
  },
];
---

<MainLayout
  title={`${blogData.title} - Spark Liang`}
  description={blogData.summary}
  frontmatter={{ title: blogData.title, pubDate: blogData.pubDate, summary: blogData.summary, tags: blogData.tags }}
>
  <!-- Hero -->
  <header class="sp-wrap sp-hero sp-hero--single" style="padding-bottom:2rem">
    <div class="sp-stack">
      <a class="sp-text-link" href="/blog">← 内容中心</a>
      <p class="sp-eyebrow">{blogData.type} · 自我认知</p>
      <h1 class="sp-h1" style="max-width:14em;font-size:clamp(2.2rem,5vw,4rem)">你是谁？<br />从过去决定论到<em>未来创造论</em>的思维革命</h1>
      <p class="sp-lede">{blogData.summary}。</p>
      <p class="sp-meta">{blogData.author} · <time datetime={blogData.pubDate.toISOString()}>{formatDate(blogData.pubDate)}</time></p>
      <Tags tags={blogData.tags} />
    </div>
    <nav aria-label="本文目录">
      <ol class="sp-layers">
        {toc.map((t) => (
          <li><a href={`#${t.id}`}><span class="sp-meta">{t.num}</span><strong>{t.title}</strong><span class="sp-layers__metaphor">{t.note}</span></a></li>
        ))}
      </ol>
    </nav>
  </header>

  <!-- 01 思考实验 -->
  <section class="sp-wrap sp-section sp-section--alt sp-chapter" id="experiment" aria-labelledby="experiment-title">
    <SectionIntro
      id="experiment-title"
      eyebrow="01 · 思考实验"
      title="先问自己一个问题：<em>“我是谁？”</em>"
      copy="让我们从一个简单的问题开始探索自我认知的奥秘。"
    />
    <div class="sp-card sp-card--pad-lg sp-card--heavy">
      <p class="sp-copy">我们开始吧。我想请你先做一个小小的思考实验。闭上眼睛，花几秒钟时间，问问自己：<strong>“我是谁？”</strong></p>
      <p class="sp-copy">好，睁开眼睛。你的脑海里可能闪过了一些答案，比如你的名字、职业、角色（父亲、女儿），或者是一些形容词（一个努力的人、一个内向的人）。</p>
      <div class="sp-mine" style="background:var(--sp-alt)">
        <p class="sp-eyebrow">颠覆认知的事实</p>
        <p>现在，我要告诉你一个可能会颠覆你认知的事实：<strong>这些答案，都不是真正的你。</strong></p>
      </div>
      <p class="sp-body">这听起来可能有点玄，但这是我们这节课最核心、也是最能赋予你力量的起点。我们来一步步拆解。</p>
    </div>
  </section>

  <!-- 02 第一课 -->
  <section class="sp-wrap sp-section sp-chapter" id="lesson-1" aria-labelledby="lesson-1-title">
    <SectionIntro
      id="lesson-1-title"
      eyebrow="02 · 第一课"
      title="区分<em>“你”</em>和“你的东西”"
      copy="摆脱身份认同的牢笼，找回真正的自己。"
    >
      <p class="sp-copy">我们从小到大，习惯性地将自己和我们所拥有的一切划上等号。这是一种非常普遍但极具限制性的思维模式，我们称之为<strong>“身份认同”（Identification）</strong>。</p>
    </SectionIntro>

    <div class="sp-stack" style="gap:1.25rem">
      <p class="sp-eyebrow sp-eyebrow--danger">常见的身份认同陷阱</p>
      <div class="sp-grid sp-grid--3">
        {coreIdeas.map((idea, i) => (
          <article class="sp-card sp-card--pad">
            <span class="sp-meta">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="sp-h3">{idea.title}</h3>
            <p class="sp-body">{idea.description}</p>
          </article>
        ))}
      </div>
    </div>

    <div class="sp-stack" style="gap:1.25rem">
      <div class="sp-stack" style="gap:0.5rem">
        <p class="sp-eyebrow">练习</p>
        <h3 class="sp-h3" style="font-size:clamp(1.35rem,2.4vw,1.8rem)">从“是”到“拥有”的语言切换</h3>
        <p class="sp-body">这个心法的第一个实践，就是有意识地在语言上进行区分（Differentiation）。</p>
      </div>
      <div class="sp-grid sp-grid--2">
        <article class="sp-card sp-card--pad-lg">
          <p class="sp-eyebrow sp-eyebrow--danger">不要再说</p>
          <p class="sp-h3">“我很焦虑。”</p>
        </article>
        <article class="sp-card sp-card--pad-lg sp-card--heavy">
          <p class="sp-eyebrow">尝试对自己说</p>
          <p class="sp-h3">“我正在体验到一种叫做‘焦虑’的情绪。”</p>
          <p class="sp-h3">“我拥有一个焦虑的感受。”</p>
        </article>
      </div>
      <p class="sp-copy">感觉一下这两句话的不同。第一句让你成为了焦虑的“囚犯”，而第二句让你成为了焦虑的“观察者”。当你能够观察它时，你就和它之间拉开了一个距离，这个距离就是你的自由和力量所在。你不再需要被动地被它控制，你可以选择如何与它共处。</p>
    </div>

    <div class="sp-mine" style="background:var(--sp-alt)">
      <p class="sp-eyebrow">小结</p>
      <p>你不是你的身体、思维或情绪。它们是你生命体验的一部分，是你所拥有的，但它们不能定义你。你远比这一切更广阔。这是摆脱过去束缚的第一步。</p>
    </div>
  </section>

  <!-- 03 第二课 -->
  <section class="sp-wrap sp-section sp-section--alt sp-chapter" id="lesson-2" aria-labelledby="lesson-2-title">
    <SectionIntro
      id="lesson-2-title"
      eyebrow="03 · 第二课"
      title="重塑你的语言，<em>重塑你的未来</em>"
      copy="从“因为” vs.“因此”的语言切换中获得力量。"
    >
      <p class="sp-copy">语言是我们思考和构建现实的基本工具。我们使用的词语，在潜移默化中决定了我们的心态和行动。</p>
    </SectionIntro>

    <div class="sp-grid sp-grid--2">
      {languageShift.map((shift) => (
        <article class={`sp-card sp-card--pad-lg ${shift.positive ? "sp-card--heavy" : ""}`}>
          <p class={`sp-eyebrow ${shift.positive ? "" : "sp-eyebrow--danger"}`}>{shift.label}</p>
          <h3 class="sp-h3">“{shift.type}”：{shift.description}</h3>
          <p class="sp-body">{shift.lead}</p>
          {shift.examples.map((example) => (
            <div class="sp-fit"><p>“{example}”</p></div>
          ))}
          <p class="sp-body">{shift.result}</p>
        </article>
      ))}
    </div>

    <div class="sp-mine">
      <p class="sp-eyebrow">小结</p>
      <p>停止用“因为”来解释你的现在，开始用“因此”来创造你的未来。你的过去不决定你的未来，你现在基于未来的选择，才决定你的未来。</p>
    </div>
  </section>

  <!-- 04 第三课 -->
  <section class="sp-wrap sp-section sp-chapter" id="lesson-3" aria-labelledby="lesson-3-title">
    <SectionIntro
      id="lesson-3-title"
      eyebrow="04 · 第三课"
      title="真正的成长是<em>“转移”</em>，不是“改变”"
      copy="学会接纳现状，然后优雅地转移到新的方向。"
    >
      <p class="sp-copy">当我们意识到自己某些模式不再有效时，我们的第一反应往往是“我要改变它！”但“改变”这个词本身就隐藏着一个陷阱。</p>
    </SectionIntro>

    <div class="sp-grid sp-grid--2">
      <article class="sp-card sp-card--pad-lg">
        <p class="sp-eyebrow sp-eyebrow--danger">改变</p>
        <h3 class="sp-h3">“改变”的内在冲突</h3>
        <p class="sp-body">当你对自己说“我要改变我拖延的坏毛病”时，你其实在对自己说两件事：</p>
        <ol class="sp-steps">
          <li>拖延是“坏”的、是“错”的</li>
          <li>拥有这个毛病的“我”也是不好的</li>
        </ol>
        <p class="sp-body">这是一种自我否定和自我攻击。你内在的一个部分在评判和攻击另一个部分。这种内在的战争，会消耗你大量的心理能量，而且往往效果不佳，甚至会产生反弹。</p>
        <div class="sp-fit"><p>你越是告诉自己“不要拖延”，拖延的念头可能就越强烈。</p></div>
      </article>

      <article class="sp-card sp-card--pad-lg sp-card--heavy">
        <p class="sp-eyebrow">转移</p>
        <h3 class="sp-h3">“转移”的接纳与创造</h3>
        <p class="sp-body">“转移”是一个更智慧、更优雅的词。它意味着：</p>
        <dl class="sp-dl">
          {shiftSteps.map((s, i) => (
            <div><dt>{String(i + 1).padStart(2, "0")} · {s.title}</dt><dd>{s.text}</dd></div>
          ))}
        </dl>
        <div class="sp-mine" style="background:var(--sp-alt)">
          <p>“转移”不否定过去，它只是增加了一个新的选择。它不是一场你死我活的战争，而是一次平顺的范畴切换。它把能量从“对抗旧的”转移到了“创造新的”上面。</p>
        </div>
      </article>
    </div>

    <div class="sp-mine" style="background:var(--sp-alt)">
      <p class="sp-eyebrow">小结</p>
      <p>不要再试图“改变”自己，那会让你陷入内耗。学会接纳你现在所拥有的一切，然后有意识地转移到你更想去的方向。“转移”不否定过去，而是增加新的选择。</p>
    </div>
  </section>

  <!-- 05 终极领悟 -->
  <section class="sp-wrap sp-section sp-section--alt sp-chapter" id="insight" aria-labelledby="insight-title">
    <SectionIntro
      id="insight-title"
      eyebrow="05 · 终极领悟"
      title="我决定我是谁，<em>不凭什么</em>"
      copy="当你把前面的思维方式融会贯通时，你就会来到这个终极的、也是最自由的领悟。"
    />

    <div class="sp-grid sp-grid--2">
      <article class="sp-card sp-card--pad-lg">
        <span class="sp-meta">01</span>
        <h3 class="sp-h3">“不凭什么”</h3>
        <p class="sp-body">这意味着你的价值和身份，不依赖于任何外在的条件。</p>
        <ul class="sp-check">
          <li>你的价值，不取决于你的银行账户、职位头衔、他人的评价。</li>
          <li>你的身份，不取决于你过去的成功或失败。</li>
        </ul>
      </article>
      <article class="sp-card sp-card--pad-lg sp-card--heavy">
        <span class="sp-meta">02</span>
        <h3 class="sp-h3">“我决定”</h3>
        <p class="sp-body">这是一个宣告（Declaration）。语言具有创造的力量。当你发自内心地宣告时，你就为自己的生命设定了一个新的“出厂设置”。</p>
        <div class="sp-mine" style="background:var(--sp-alt)">
          <p>“我决定我是一个自信、有爱的人。”</p>
        </div>
        <p class="sp-body">这不是自欺欺人，而是在创造一个新的现实。这个宣告会像磁场一样，开始吸引和组织你的思维、情绪和行为，让它们与这个新的身份保持一致。</p>
      </article>
    </div>

    <div class="sp-card sp-card--pad-lg sp-analogy">
      <p class="sp-eyebrow">所以，你是谁？</p>
      <h3 class="sp-h3" style="font-size:clamp(1.35rem,2.6vw,2rem)">答案是：在此时此刻，你决定你是谁，你就是谁。</h3>
      <p class="sp-body">你可以决定你是一个学习者，一个创造者，一个有爱的人。这个决定，不需要任何理由，也不需要任何过去来证明。它本身，就是力量的源泉。</p>
    </div>
  </section>

  <!-- 常见问题 -->
  <section class="sp-wrap sp-section" aria-labelledby="faq-title">
    <SectionIntro id="faq-title" eyebrow="常见问题" title="读完之后，大家最常问的" />
    <div><Accordion items={faqData} /></div>
  </section>

  <CtaCard
    eyebrow="下一步"
    title="觉得这篇文章有启发？"
    copy="你可以去浏览我正在用的日常清单，去 Instagram 找我聊聊你的想法，或者了解我的官方合作机构与咨询服务。"
    cta="浏览我的清单"
    href="/stack"
  />
</MainLayout>
