              <ul class="sp-check">{v.good.items.map((x) => <li>{x}</li>)}</ul>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- 最终结论 -->
    <div class="sp-stack" style="gap:1.25rem">
      <div class="sp-stack" style="gap:0.4rem">
        <p class="sp-eyebrow">最终结论</p>
        <h3 class="sp-h3" style="font-size:clamp(1.35rem,2.4vw,1.8rem)">心法修炼的终极目标</h3>
      </div>
      <div class="sp-grid sp-grid--3">
        {goals.map((g, i) => (
          <article class="sp-card sp-card--pad">
            <span class="sp-meta">{n(i)}</span>
