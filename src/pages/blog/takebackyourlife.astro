  <section class="sp-wrap sp-section sp-section--alt sp-chapter" id="framework" aria-labelledby="framework-title">
    <SectionIntro
      id="framework-title"
      eyebrow="03 · 课程精炼总结"
      title="核心理论框架：<em>三大模型</em>与三大观点"
      copy="深入理解五大心法背后的三大核心模型和主要观点。"
    />

    <!-- 三大核心模型 -->
    <div class="sp-stack" style="gap:1.25rem">
      <p class="sp-eyebrow">三大核心模型</p>

      <article class="sp-card sp-card--pad-lg sp-card--heavy">
        <span class="sp-meta">模型 01</span>
        <h3 class="sp-h3">自我区分模型 (Self-Differentiation Model)</h3>
        <p class="sp-body"><strong>核心洞见：</strong>“我”不等于“我的体验”。我们是一个能够观察思维、情绪和身体感受的意识中心。</p>
        <div class="sp-grid sp-grid--2" style="gap:1rem">
          <div class="sp-fit">
            <p class="sp-eyebrow sp-eyebrow--danger">融合状态 (Fusion)</p>
            <ul class="sp-check"><li>我就是我的想法</li><li>我就是我的情绪</li><li>被体验完全淹没</li><li>失去选择能力</li></ul>
          </div>
          <div class="sp-fit">
            <p class="sp-eyebrow">区分状态 (Defusion)</p>
            <ul class="sp-check"><li>我拥有想法，但我不是想法</li><li>我感受情绪，但我不是情绪</li><li>保持观察者视角</li><li>创造选择空间</li></ul>
          </div>
        </div>
        <div class="sp-mine" style="background:var(--sp-alt)">
          <p class="sp-eyebrow">实践要点</p>
          <p>通过语言标签化练习（“我注意到一个愤怒的想法”）和身体扫描，培养观察者意识。</p>
        </div>
      </article>

      <article class="sp-card sp-card--pad-lg sp-card--heavy">
        <span class="sp-meta">模型 02</span>
        <h3 class="sp-h3">范畴模型 (Paradigm Model)</h3>
        <p class="sp-body"><strong>核心公式：</strong>范畴决定内容。我们透过内在信念系统（范畴）这副“有色眼镜”来体验客观现实（内容）。</p>
        <div class="sp-grid sp-grid--3" style="gap:1rem">
          <div class="sp-fit"><p class="sp-eyebrow">内容 (Content)</p><p>客观事实，中立的人事物</p></div>
          <div class="sp-fit"><p class="sp-eyebrow">范畴 (Paradigm)</p><p>信念系统，解读框架</p></div>
          <div class="sp-fit"><p class="sp-eyebrow">体验 (Experience)</p><p>主观感受，情绪反应</p></div>
        </div>
        <div class="sp-mine" style="background:var(--sp-alt)">
          <p class="sp-eyebrow">革命性转变</p>
          <p>改变范畴比改变内容更有力量。当我们升级信念系统，整个世界的体验就会改变。</p>
        </div>
      </article>

      <article class="sp-card sp-card--pad-lg sp-card--heavy">
        <span class="sp-meta">模型 03</span>
        <h3 class="sp-h3">信念系统模型 (Belief System Model)</h3>
        <p class="sp-body"><strong>核心转变：</strong>从外在驱动的“反应者”转向内在驱动的“创造者”。</p>
        <div class="sp-grid sp-grid--2" style="gap:1rem">
          <div class="sp-fit">
            <p class="sp-eyebrow sp-eyebrow--danger">受害者范畴</p>
            <dl class="sp-dl">
              <div><dt>信念</dt><dd>世界是危险的，资源稀缺</dd></div>
              <div><dt>身份</dt><dd>无助的受害者</dd></div>
              <div><dt>提问</dt><dd>“为什么是我？”</dd></div>
              <div><dt>行为</dt><dd>抱怨、指责、逃避</dd></div>
            </dl>
          </div>
          <div class="sp-fit">
            <p class="sp-eyebrow">创造者范畴</p>
            <dl class="sp-dl">
              <div><dt>信念</dt><dd>世界充满可能，挑战是礼物</dd></div>
              <div><dt>身份</dt><dd>有力量的创造者</dd></div>
              <div><dt>提问</dt><dd>“我能创造什么？”</dd></div>
              <div><dt>行为</dt><dd>负责、探索、创新</dd></div>
            </dl>
          </div>
        </div>
        <div class="sp-mine" style="background:var(--sp-alt)">
          <p class="sp-eyebrow">修炼要点</p>
          <p>通过“为所有体验负责任”的练习，逐步从受害者身份转向创造者身份。</p>
        </div>
      </article>
    </div>

    <!-- 三大主要观点 -->
    <div class="sp-stack" style="gap:1.25rem">
      <p class="sp-eyebrow">三大主要观点</p>
      {views.map((v, i) => (
        <article class="sp-card sp-card--pad-lg">
          <span class="sp-meta">观点 {n(i)}</span>
          <h3 class="sp-h3">{v.title}</h3>
          <div class="sp-grid sp-grid--2" style="gap:1rem">
