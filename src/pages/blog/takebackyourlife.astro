---
import MainLayout from "../../layouts/MainLayout.astro";
import SectionIntro from "../../components/ui/SectionIntro.astro";
import Accordion from "../../components/ui/Accordion.astro";
import CtaCard from "../../components/ui/CtaCard.astro";
import Tags from "../../components/ui/Tags.astro";
import { formatDate } from "../../utils";

// 博客数据 - 这是必需的元数据
export const blogData = {
  title: "解锁你的内在力量——如何真正'搞定自己'的实践指南",
  pubDate: new Date('2025-09-01'),
  author: "Spark Liang",
  tags: ["自我成长", "不内耗", "个人成长系统", "思维模型", "情绪管理", "心理学"],
  summary: "一门关于如何识别、理解并重写内在'自动化程序'的终极实践指南，帮你从内耗走向自主创造",
  type: "深度实践",
  featured: true
};

const stats = ["5 · 核心心法", "100% · 实践导向", "终身 · 可用工具", "心法 · 修炼体系"];

const toc = [
  { id: "start", num: "01", title: "这样的时刻", note: "内耗从哪来" },
  { id: "methods", num: "02", title: "五大心法", note: "完整修炼体系" },
  { id: "framework", num: "03", title: "理论框架", note: "三大模型 · 三大观点" },
  { id: "module-1", num: "04", title: "方法 vs 心法", note: "术与道" },
  { id: "heart-1", num: "05", title: "心法一", note: "体验我的体验" },
  { id: "cases", num: "06", title: "实践案例", note: "拖延与冲突" },
];

// 五大心法
const heartMethods = [
  {
    title: "体验我的体验",
    subtitle: "从情绪的奴隶到内在的主人",
    description: "学会自我区分模型，将自己从纷繁复杂的念头和汹涌的情绪中分离开来。",
    benefit: "拥有在情绪风暴中保持稳定的能力",
    points: [
      { name: "区分技术", text: "将自我与体验分离" },
      { name: "观察者视角", text: "获得选择的空间" },
    ],
  },
  {
    title: "沟通我的感受，让他人收到",
    subtitle: "从自我表达到深度连接",
    description: "掌握事实-感受-评判区分法，建立“沟通效果由我负责”的心态。",
    benefit: "成为高情商沟通者，话语充满力量和连接的温度",
    points: [
      { name: "事实-感受-评判", text: "区分三种表达方式" },
      { name: "责任心态", text: "沟通效果由我负责" },
    ],
  },
  {
    title: "愿意为所有事情负责任",
    subtitle: "从被动受害者到主动创造者",
    description: "理解范畴决定内容模型，学会创造者提问法，从“为什么是我？”转向“我能创造什么？”",
    benefit: "告别抱怨指责，拿回创造理想生活的主导权",
    points: [
      { name: "范畴决定内容", text: "信念系统塑造现实" },
      { name: "创造者提问", text: "从被动到主动" },
    ],
  },
  {
    title: "接纳我所拥有的",
    subtitle: "从内在分裂到完整整合",
    description: "学会“是这样”的力量，停止与现实的对抗，拥抱“猪”的智慧。",
    benefit: "结束与自己的战争，内心变得平静和整合",
    points: [
      { name: "“是这样”的力量", text: "停止与现实对抗" },
      { name: "拥抱“猪”", text: "接纳与整合内在" },
    ],
  },
  {
    title: "依我的原则立场生活",
    subtitle: "从摇摆不定到内在坚定",
    description: "通过深刻自我探索，提炼核心原则，建立稳固立场。",
    benefit: "拥有强大内在定力，活出真实 authentic 的自己",
    points: [
      { name: "核心原则", text: "提炼人生指导原则" },
      { name: "稳固立场", text: "建立内在定海神针" },
    ],
  },
];

// 三大主要观点
const views = [
  {
    title: "从“方法”到“心法”的根本转变",
    bad: { label: "传统“方法”思维", items: ["外在技巧和工具", "一招鲜，治标不治本", "依赖外在条件", "容易反弹和失效"] },
    good: { label: "“心法”修炼", items: ["内在状态和存在品质", "升级内在操作系统", "培养核心能力", "持久的根本转变"] },
  },
  {
    title: "发现范畴 vs 探索范畴",
    bad: { label: "发现范畴 (Discovery)", items: ["问题 → 分析 → 解决方案", "寻找已知答案", "教练作为“专家”", "局限于现有框架"] },
    good: { label: "探索范畴 (Exploration)", items: ["现象 → 体验 → 洞见浮现", "创造新的可能性", "教练作为“镜子”", "开启未知领域"] },
  },
  {
    title: "抗拒的力量 vs 接纳的力量",
    bad: { label: "抗拒模式", items: ["“这不应该发生”", "与现实对抗", "大量能量内耗", "问题持续存在"] },
    good: { label: "接纳模式", items: ["“是这样” (It is what it is)", "与现实协作", "释放能量用于创造", "真正的改变成为可能"] },
  },
];

// 心法修炼的终极目标
const goals = [
  { title: "成为一个“完整”的人", text: "不再被内在分裂所困扰，能够整合所有的“猪”（包括那些被评判为“负面”的特质），拥抱一个完整、真实、有力量的自己。" },
  { title: "活出真正的“原则立场”", text: "不再随波逐流或被外在期望所驱动，而是基于深度自我探索提炼出的核心原则，过一种由内而外、真实 authentic 的生活。" },
  { title: "成为他人的“光”", text: "当你真正掌握了这五大心法，你不仅能够“搞定自己”，更能成为一个能够点亮他人生命的卓越教练和领导者，为世界带来更多的光明和可能性。" },
];

// 发现范畴 vs 探索范畴
const paradigms = [
  {
    name: "发现范畴 (Discovery Paradigm)",
    mode: "寻找已知答案的地图模式",
    belief: "世界是已知的，存在一个“正确”的答案等着被找到。",
    metaphor: "你手里有一张完整的城市地图，你的任务是找到从①点到②点的最短路径。一旦找到，任务就结束了。",
    steps: [
      "遇到问题（例如：“我总是拖延”）",
      "启动分析：为什么会拖延？原因是什么？",
      "寻找解决方案：在已有的知识库里寻找“正确答案”",
      "应用方案：尝试使用工具",
      "目标达成 / 心安：问题解决了，或者暂时缓解了，思考停止",
    ],
    coach: "教练扮演“专家”或“问题解决者”的角色，倾向于给建议、给答案，帮助客户“修复”问题。",
    verdictLabel: "局限性",
    verdict: "这种模式限制了创造力和新的可能性。它假设所有答案都已存在，从而关闭了通往真正未知领域的大门。",
    positive: false,
  },
  {
    name: "探索范畴 (Exploration Paradigm)",
    mode: "深入未知领域的冒险模式",
    belief: "世界是充满可能性的，答案是在过程中不断浮现和创造的。",
    metaphor: "你是一名探险家，进入一片前人未至的丛林。你没有地图，你的任务是保持警觉和好奇，从中开辟出一条新的道路。",
    steps: [
      "观察到一个现象（例如：“我注意到我正在拖延”）",
      "保持好奇与接纳：不去评判拖延的好坏",
      "深入体验：全然地感受当下的思维、情绪和身体状态",
      "洞见浮现：在全然的体验中，新的认知、新的选择自然浮现",
      "持续探索：这个过程是动态和持续的，没有终点",
    ],
    coach: "教练扮演“伙伴”或“镜子”的角色，通过创造一个安全的空间，支持客户自我探索，相信答案在客户自己身上。",
    verdictLabel: "力量所在",
    verdict: "这是通往真正创造力和深刻转变的唯一路径。它开启了无限的可能性空间。",
    positive: true,
  },
];

// 课程的核心要求
const leaps = [
  { title: "刻意地放下“寻找答案”的冲动", text: "抵制住给建议的诱惑，从“帮助客户解决问题”转向“支持客户探索可能性”。" },
  { title: "真正地活在过程中", text: "允许自己和客户都处于“不知道”的状态。虽然会带来不适感，但这是成长的必经之路。" },
  { title: "开启无限可能性", text: "在探索范畴中，每一次会谈都可能成为一次独特的冒险，催化出前所未有的洞见和转变。" },
];

// 第一层体验
const primary = [
  { name: "思维", text: "脑海中闪过的念头、图像、声音、判断、回忆、计划等", example: "例如：“我今天的工作还没完成”、“他为什么这么说我？”" },
  { name: "情绪", text: "由内外刺激引发的能量波动和心理感受", example: "例如：喜悦、愤怒、悲伤、焦虑、兴奋、平静" },
  { name: "身体感受", text: "纯粹的生理感知", example: "例如：肩膀的僵硬、胃部的抽搐、手心的汗、心跳的加速" },
];

// 融合 vs 区分
const fusion = [
  {
    label: "融合状态 (Fusion)",
    text: "我们大部分时间的默认状态，与内在体验完全认同。",
    rows: [
      { name: "思维融合", text: "想法：“我做不好演讲” → “我就是不擅长演讲” → 逃避" },
      { name: "情绪融合", text: "焦虑 → 被完全淹没 → 暴饮暴食或刷手机" },
    ],
    result: "失去自由和选择，生活变成自动化反应",
    positive: false,
  },
  {
    label: "区分状态 (Defusion)",
    text: "通过修炼达到的状态，能够“后退一步”观察内在体验。",
    rows: [
      { name: "思维区分", text: "“我注意到一个‘做不好演讲’的想法。它只是想法，不等于事实。”" },
      { name: "情绪区分", text: "“我观察到焦虑正在通过我的身体。我能感受它，但不被它控制。”" },
    ],
    result: "创造选择空间，获得有意识回应的能力",
    positive: true,
  },
];

// 实践案例
const practicalCases = [
  {
    title: "搞定拖延症",
    subtitle: "从自我内耗到高效行动",
    oldPattern: {
      title: "旧系统：被“猪”掌控",
      behaviors: ["内心两个小人打架：一个督促，一个反抗", "在纠结和自责中继续拖延", "最终熬夜赶工，质量堪忧"],
    },
    newPattern: {
      title: "新系统：心法应用",
      steps: [
        "观察内在体验：区分思维、情绪、身体感受",
        "拥抱“拖延的猪”：理解其背后的需求",
        "重写故事：从“太难了”到“我能创造什么”",
        "用感受连接行动：与内在达成协议",
      ],
    },
    result: "轻松完成任务，打破拖延-自责循环，体验到有力量的自我管理",
  },
  {
    title: "搞定“人际冲突”",
    subtitle: "从互相指责到深度理解",
    oldPattern: {
      title: "旧系统：自动化反应",
      behaviors: ["立刻反击或冷战", "陷入“对错”游戏", "关系出现裂痕，双方受伤"],
    },
    newPattern: {
      title: "新系统：心法应用",
      steps: [
        "稳住自己：观察并接纳内在愤怒",
        "负责任：为自己的感受负 100% 责任",
        "用“我”句式搭建沟通桥梁",
        "基于“爱与连接”原则深度聆听",
      ],
    },
    result: "潜在危机转化为加深理解的机会，关系更加亲密",
  },
];

// 收尾的三个行动
const nextSteps = [
  { title: "持续练习", text: "五大心法需要终身实践的功夫" },
  { title: "从小事开始", text: "在日常生活中刻意练习心法" },
  { title: "寻找伙伴", text: "组成练习小组，相互提供“镜子”" },
];

// FAQ 数据（Accordion 格式）
const faqData = [
  {
    title: "什么是“自动化程序”？为什么要重写它？",
    description: "自动化程序指我们内在的旧有思维模式、情绪反应和行为习惯，就像电脑的默认设置。这些程序让我们变成生活的“机器人”，不断重复同样的模式。重写这些程序意味着重新获得选择权，从被动反应转向主动创造。",
  },
  {
    title: "五大心法之间是什么关系？必须按顺序学习吗？",
    description: "五大心法是一个有机整体。心法一是基础，提供觉察能力；心法二和三是核心技能；心法四提供整合力量；心法五是最终成就。虽然建议按顺序深入，但它们可以同时练习，相互促进。",
  },
  {
    title: "为什么要“养猪”而不是“杀猪”？",
    description: "“猪”代表我们内心那些不被接纳的部分（如懒惰、恐惧、自私等）。“杀猪”会导致内在分裂和对抗，消耗大量能量。“养猪”意味着接纳并整合这些能量，理解它们的积极动机，转化为成长的动力。",
  },
  {
    title: "“范畴决定内容”是什么意思？",
    description: "这是心法三的核心理论。“内容”是客观事实，“范畴”是我们的信念系统和世界观。同样的事实，通过不同的范畴，会产生完全不同的体验。改变范畴（信念），就能改变我们对现实的体验和感受。",
  },
  {
    title: "如何知道自己是在“反应”还是“回应”？",
    description: "反应是基于旧模式的无意识自动行为，通常很快、情绪化、重复性。回应是基于当下觉察和选择的有意识行为，通常有停顿、考虑、创新性。通过心法一的练习，你会越来越敏锐地感知这个差别。",
  },
  {
    title: "这套心法适合哪些人？有什么前提条件吗？",
    description: "适合所有渴望深度自我探索和成长的人。唯一的前提是：愿意向内看，愿意为自己的体验负责，愿意挑战自己的舒适区。无论你的年龄、职业、文化背景如何，只要你准备好真正“搞定自己”，这套心法都会有效。",
  },
  {
    title: "学会这五大心法需要多长时间？",
    description: "理解概念可能只需几小时，但真正掌握是一个终身的修炼过程。通常 3–6 个月的刻意练习会让你感受到明显变化，1–2 年能建立稳定的新模式。记住，这不是一次性学会的知识，而是不断深化的功夫。",
  },
  {
    title: "如何开始实践这五大心法？",
    description: "从日常生活中的小事开始：每天花 5–10 分钟觉察自己的内在状态（心法一），在沟通中练习“我”句式（心法二），遇到挑战时问“我能创造什么”（心法三）。建议找练习伙伴，相互提供“镜子”和支持。",
  },
];

const n = (i: number) => String(i + 1).padStart(2, "0");
---

<MainLayout
  title={`${blogData.title} - Spark Liang`}
  description={blogData.summary}
  frontmatter={{ title: blogData.title, pubDate: blogData.pubDate, summary: blogData.summary, tags: blogData.tags }}
>
  <!-- Hero -->
  <header class="sp-wrap sp-hero sp-hero--single" style="padding-bottom:2rem">
    <div class="sp-stack">
      <a class="sp-text-link" href="/blog">← 内容中心</a>
      <p class="sp-eyebrow">{blogData.type} · 内在修炼</p>
      <h1 class="sp-h1" style="max-width:14em;font-size:clamp(2.2rem,5vw,4rem)">解锁你的内在力量——如何真正<em>“搞定自己”</em>的实践指南</h1>
      <p class="sp-lede">一门关于如何真正“搞定自己”的实践课：教你识别、理解并重写内在“自动化程序”的终极实践指南，帮你从内耗走向自主创造。</p>
      <div style="display:flex;flex-wrap:wrap;gap:0.5rem">
        {stats.map((s) => <span class="sp-tag sp-tag--accent">{s}</span>)}
      </div>
      <p class="sp-meta">{blogData.author} · <time datetime={blogData.pubDate.toISOString()}>{formatDate(blogData.pubDate)}</time></p>
      <Tags tags={blogData.tags} />
    </div>
    <nav aria-label="本文目录">
      <ol class="sp-layers">
        {toc.map((t) => (
          <li><a href={`#${t.id}`}><span class="sp-meta">{t.num}</span><strong>{t.title}</strong><span class="sp-layers__metaphor">{t.note}</span></a></li>
        ))}
      </ol>
    </nav>
  </header>

  <!-- 01 起点 -->
  <section class="sp-wrap sp-section sp-section--alt sp-chapter" id="start" aria-labelledby="start-title">
    <SectionIntro
      id="start-title"
      eyebrow="01 · 起点"
      title="你是否曾有过<em>这样的时刻？</em>"
      copy="让我们深入体验那些每个人都会遇到的内在挑战。"
    />

    <div class="sp-card sp-card--pad-lg sp-card--heavy">
      <p class="sp-eyebrow">内在的“小人”打架</p>
      <p class="sp-copy">脑海里有两个小人在打架：一个说“今天必须完成这项工作！”，另一个却说“太累了，刷会儿手机再说吧”……最终，你在纠结和自责中一事无成。</p>
      <p class="sp-eyebrow sp-eyebrow--danger">痛苦的现状</p>
      <ul class="sp-check">
        <li>情绪的“过山车”：一句批评就郁闷半天</li>
        <li>人生的“鬼打墙”：总在重复同样的错误模式</li>
        <li>沟通的“迷宫”：好意却让对方误解受伤</li>
      </ul>
    </div>

    <div class="sp-stack" style="gap:1.25rem">
      <h3 class="sp-h3" style="font-size:clamp(1.35rem,2.4vw,1.8rem)">我们不提供“打鸡血”式的口号</h3>
      <div class="sp-grid sp-grid--2">
        <article class="sp-card sp-card--pad-lg">
          <p class="sp-eyebrow sp-eyebrow--danger">传统方法的问题</p>
          <ul class="sp-check">
            <li>一招鲜的技巧，治标不治本</li>
            <li>激励式口号，热血三分钟</li>
            <li>外在强迫，内在对抗更激烈</li>
          </ul>
        </article>
        <article class="sp-card sp-card--pad-lg sp-card--heavy">
          <p class="sp-eyebrow">我们的心法系统</p>
          <ul class="sp-check">
            <li>深入内在世界的系统性探索</li>
            <li>终身使用的“内在操作系统升级工具”</li>
            <li>从根源改变，由内而外的蜕变</li>
          </ul>
        </article>
      </div>
    </div>

    <div class="sp-stack" style="gap:1.25rem">
      <h3 class="sp-h3" style="font-size:clamp(1.35rem,2.4vw,1.8rem)">核心转变：从内耗走向自主创造</h3>
      <div class="sp-grid sp-grid--2">
        <article class="sp-card sp-card--pad-lg">
          <p class="sp-eyebrow sp-eyebrow--danger">内耗状态</p>
