            <g fill="var(--sp-accent)" stroke="var(--sp-ink)" stroke-width="1.5">
              <circle cx="120" cy="120" r="14" class="hd-pulse" />
              <circle cx="120" cy="88" r="13" /><circle cx="120" cy="152" r="13" />
              <circle cx="92" cy="104" r="13" /><circle cx="148" cy="104" r="13" />
              <circle cx="92" cy="136" r="13" /><circle cx="148" cy="136" r="13" />
              <circle cx="120" cy="60" r="10" /><circle cx="120" cy="180" r="10" />
              <circle cx="69" cy="91" r="10" /><circle cx="171" cy="91" r="10" />
              <circle cx="69" cy="149" r="10" /><circle cx="171" cy="149" r="10" />
              <circle cx="92" cy="69" r="10" /><circle cx="148" cy="69" r="10" />
              <circle cx="92" cy="171" r="10" /><circle cx="148" cy="171" r="10" />
            </g>
          </svg>
          <!-- 显壮：大而松，肌丝漂在水里 -->
          <svg class="hd-cell__svg hd-cell__svg--bulky" viewBox="0 0 240 240" role="img" aria-label="肌浆肥大：细胞被 glycogen 和水撑大，收缩蛋白稀疏">
            <circle cx="120" cy="120" r="104" fill="color-mix(in srgb, var(--sp-danger) 8%, var(--sp-page))" stroke="var(--sp-danger)" stroke-width="3" stroke-dasharray="7 4" />
            <g fill="var(--sp-page)" stroke="var(--sp-danger)" stroke-width="1.5">
              <circle cx="120" cy="120" r="10" />
              <circle cx="84" cy="88" r="9" /><circle cx="156" cy="88" r="9" />
              <circle cx="84" cy="152" r="9" /><circle cx="156" cy="152" r="9" />
              <circle cx="120" cy="66" r="8" /><circle cx="120" cy="174" r="8" />
            </g>
            <g fill="var(--sp-danger)" font-family="var(--sp-font-mono)" font-size="10" font-weight="700" text-anchor="middle">
              <text x="62" y="124">H₂O</text><text x="178" y="124">H₂O</text>
              <text x="120" y="42">glycogen</text><text x="120" y="206">glycogen</text>
            </g>
          </svg>
          <figcaption class="sp-meta hd-cell__cap"></figcaption>
        </figure>

        <div class="sp-stack hd-mode__copy">
          <span class="sp-tag sp-tag--accent hd-mode__tag"></span>
          <h3 class="sp-h3 hd-mode__title"></h3>
