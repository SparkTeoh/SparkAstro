          <div class="sp-grid sp-grid--2" style="gap:1rem">
            <div class="sp-fit"><p class="sp-eyebrow">外观与触感</p><p class="hd-mode__look"></p></div>
            <div class="sp-fit"><p class="sp-eyebrow">代表体态</p><p class="hd-mode__who"></p></div>
          </div>
