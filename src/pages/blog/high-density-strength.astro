---
import MainLayout from "../../layouts/MainLayout.astro";
import SectionIntro from "../../components/ui/SectionIntro.astro";
import Accordion from "../../components/ui/Accordion.astro";
import CtaCard from "../../components/ui/CtaCard.astro";
import Tags from "../../components/ui/Tags.astro";
import Icon from "../../components/ui/Icon.astro";
import { formatDate } from "../../utils";

// 博客数据 - 内容中心列表靠它
export const blogData = {
  title: "高密度、零膨胀的力量训练完整指南",
  pubDate: new Date("2026-11-02"),
  author: "Spark Liang",
  tags: ["健康", "力量训练", "运动生理学", "攀岩"],
  summary: "如何练出有爆发力、却不显壮（bulky）的体态：只刺激神经募集与肌原纤维，不刺激肌浆储水。讲清原理，再用案例示范：怎么加重、一次课怎么练、练完要歇几天。",
  type: "深度实践",
  featured: true,
};

const toc = [
  { id: "mechanism", num: "01", title: "底层机制", note: "力量 ≠ 大块头" },
  { id: "rules", num: "02", title: "五大铁律", note: "只练神经与肌丝" },
  { id: "compare", num: "03", title: "全景对照", note: "一表看懂" },
  { id: "progression", num: "04", title: "阶梯计算器", note: "体积不变也能进步" },
  { id: "recovery", num: "05", title: "案例示范", note: "一次课 + 练完歇几天" },
  { id: "redlines", num: "06", title: "执行红线", note: "皮肤与肌腱安全" },
];

const stats = [
  { label: "负荷区间", value: "3–5", unit: "RM", note: "80%–90% 1RM，纯机械张力" },
  { label: "单组努力", value: "RPE 8", unit: "", note: "保留 1–2 次余力，不追求 pump" },
  { label: "组间休息", value: "3–5", unit: "分钟", note: "ATP-CP 与 CNS 完全恢复" },
  { label: "热量策略", value: "±0", unit: "kcal", note: "等热量或微缺口，存量改造" },
];

const modes = {
  density: {
    tag: "目标通道：肌原纤维肥大（myofibrillar hypertrophy）",
    title: "像把钢丝绳拧得更紧，而不是往海绵里注水",
    text: "用大重量（80%–90% 1RM）、低次数（3–5 次）、长组间休息（3–5 分钟），强迫中枢神经系统（CNS）调动高阈值快肌纤维，并让细胞内真正负责发力的收缩蛋白（actin 与 myosin）排得更密。",
    look: "放松时线条修长，发力时像压缩饼干一样硬；穿修身西装不会绷紧。",
    who: "攀岩抱石好手、体操运动员、拳击与综合格斗的轻量级选手。",
  },
  bulky: {
    tag: "需要避开的通道：肌浆肥大（sarcoplasmic hypertrophy）",
    title: "高频充血与代谢压力，把细胞撑成储水海绵",
    text: "传统健美练法用中等重量、每组 8–12 次做到力竭、短休息（30–60 秒）。肌肉为了应付缺氧和代谢产物堆积，会在非收缩空间（肌浆）里大量储存 glycogen，而每 1 克 glycogen 大约会带上 3 克水。",
    look: "围度涨得快，看起来厚重壮硕，但单位截面积的力量密度偏低，停练后也消得快。",
    who: "传统健美增肌期（bulk phase）的体态，追求极致 pump 和围度。",
  },
};

const dna = [
  {
    tag: "ACTN3 (TC) / ACE (GC)",
    title: "力量与爆发力底盘",
    text: "我的基因报告里 Power Sports Performance 是 Enhanced。快肌纤维和 CNS 天生擅长响应「大重量、3–5 次、长休息」的机械张力刺激，不需要靠充血就能拉高绝对力量。",
  },
  {
    tag: "VO2 Max Enhanced",
    title: "收干与线条引擎",
    text: "Energy Utilization 和最大摄氧量都是 Enhanced，Protein Utilization 是 Optimal。配合高强度间歇维持低体脂，能把高密度肌纤维的线条直接显出来。",
  },
  {
    tag: "COL1A1 CC / COL3A1 AA",
    title: "胶原蛋白要补上",
    text: "软组织损伤风险是 Low，但 Collagen Integrity 是 Reduced。冲大重量时要同步补 glycine、proline、维生素 C 和锌、铜，让肌腱韧带的刚性跟得上神经力量。",
  },
];

const rules = [
  {
    tag: "负荷与次数",
    spec: "80%–90% 1RM",
    title: "锁定神经募集区：每组 3–5 次",
    text: "肌肉变大主要来自代谢压力，力量和密度来自机械张力。选一个你只能标准完成 3–5 次的重量，逼 CNS 一次唤醒最高比例的快肌纤维，把 actin 和 myosin 拧得更紧。",
  },
  {
    tag: "拒绝力竭与 pump",
    spec: "RPE 8–8.5",
    title: "永远保留 1–2 次余力",
    text: "健身房追求的酸胀充血感（pump）正是视觉膨胀的来源。如果一个重量你最多做 5 次，那么第 3 或第 4 次动作速度开始变慢时就停下，从源头切断细胞储水的信号。",
  },
  {
    tag: "组间恢复",
    spec: "ATP-CP 重置",
    title: "组间休息拉长到 3–5 分钟",
    text: "30–60 秒的短休息会制造代谢压力，促使细胞储水膨胀。严格休息 3–5 分钟，等呼吸完全平复、神经与磷酸肌酸系统恢复，每一组都能输出最高质量的爆发力。",
  },
  {
    tag: "动作节奏",
    spec: "F = m × a",
    title: "强调向心爆发，弱化离心",
    text: "围度增长很大一部分来自慢速下放（离心微撕裂）。推起、拉起时意图追求最快速度；下放受控即可，不刻意慢放 3–4 秒。再叠加等长收缩（平板、悬垂）和爆发动作（壶铃摇摆），快速提高肌腱刚性。",
  },
  {
    tag: "热量与碳水",
    spec: "等热量 + 蛋白质 1.6–2.0 g/kg",
    title: "建筑工很猛，但不给多余的砖头",
    text: "即使训练偶尔给出「变大」的信号，只要维持等热量（maintenance calories）或极轻微的热量缺口，身体就没有多余能量去合成大体积新组织，只能对现有肌纤维做内部升级：淘汰低效结构、排紧肌丝、消耗肌内脂肪。同时控制精制碳水，避免过多 glycogen 锁水造成浮肿。",
  },
];

const compare = [
  ["核心生理机制", "神经募集效率提升 + 肌原纤维致密化", "肌浆肥大（glycogen 与细胞水分扩充）"],
  ["每组次数与负荷", "3–5 次，80%–90% 1RM", "8–15 次，65%–75% 1RM"],
  ["单组状态", "保留 1–2 次余力（RPE 8），动作干脆", "做到力竭（RPE 10），追求酸痛与充血"],
  ["组间休息", "3–5 分钟，神经与磷酸肌酸完全恢复", "45–90 秒，维持代谢压力与充血"],
  ["动作选择", "多关节复合动作：深蹲、硬拉、引体、推举", "大量单关节孤立动作：弯举、飞鸟、夹胸"],
  ["饮食策略", "等热量或微缺口 + 高蛋白 + 控精制碳水", "明显热量盈余 + 高碳水撑大体积"],
  ["穿衣与触感", "穿西装显瘦挺拔，摸起来紧实坚硬", "修身衣物容易绷紧，触感偏软胀"],
];

const upgrades = [
  {
    title: "神经系统解锁隐藏算力",
    text: "未经训练的人发力时只能调动一部分肌纤维；大重量训练后，CNS 能同时唤醒更高比例的运动单位，放电频率（rate coding）也更快。就像本来 5 个人散漫地拉绳，变成 9 个人听口令一起拉。",
  },
  {
    title: "撤掉身体的内部刹车",
    text: "新手发力时，负责反向动作的拮抗肌会本能地紧张，等于一边踩油门一边踩刹车。神经力量训练让大脑学会放松拮抗肌（antagonist inhibition），力量传导的损耗降到最低。",
  },
  {
    title: "肌腱刚性与蛋白丝致密化",
    text: "长期承受 85% 以上的重量，肌腱会变得像高强度碳纤维弹簧，力量传递不再卸力；肌细胞里的收缩蛋白丝也排得更紧，单位面积的张力随之上升。",
  },
];

const stages = [
  { id: "w1", weeks: "第 1–2 周", name: "适应蓄力", scheme: "5 组 × 3 次", note: "RPE 7.5–8，还能多做 2 次。推起速度要快，共 15 次高质量触发。" },
  { id: "w3", weeks: "第 3–4 周", name: "容量微进", scheme: "5 组 × 4 次", note: "重量不变，每组加 1 次（共 20 次）。第 4 次轨迹不变形、速度不掉。" },
  { id: "w5", weeks: "第 5–6 周", name: "密度巩固", scheme: "5 组 × 5 次", note: "重量不变，推进到 5×5（共 25 次）。最后一次依然留至少 1 次余力。" },
  { id: "w7", weeks: "第 7 周", name: "减载 deload", scheme: "3 组 × 3 次（−25%）", note: "主动减重 25%、组数减少，让累积疲劳的 CNS 和肌腱胶原完成超量恢复。", kind: "deload" },
  { id: "w8", weeks: "第 8 周", name: "新周期", scheme: "回到 5 组 × 3 次", note: "稳拿 5×5 并减载后，小幅加重，退回 5×3 开始新一轮阶梯。", kind: "next" },
];

const lifts = [
  { label: "杠铃后深蹲", weight: 60 },
  { label: "六角杠硬拉", weight: 70 },
  { label: "负重引体向上（外挂重量）", weight: 15 },
  { label: "站姿推举", weight: 40 },
];

// 示范用的一次下肢课
const sample = [
  { slot: "A · 神经主项", rest: "休 3–5 分钟", name: "杠铃后深蹲", dose: "5 组 × 3 次（RPE 8）", note: "下放约 1 秒受控，底部瞬间全力站起。第 3 次速度开始变慢就收组，不硬挤第 4 次。" },
  { slot: "B · 向心爆发", rest: "休 2–3 分钟", name: "壶铃摇摆 / 跳箱", dose: "4 组 × 5 次", note: "每一下都追求最快速度，做到速度掉了就停。练的是发力速度，不是累。" },
  { slot: "C · 等长收缩", rest: "休 90 秒", name: "高张力平板支撑（RKC plank）", dose: "3 组 × 30 秒", note: "全身绷到最紧，30 秒就够。整节课约 45 分钟，练完应该是精神清醒，不是瘫软。" },
];

// 练完大约要隔多久，才再练同一个部位 / 同一种强度
const recovery = [
  { hours: "72", label: "大重量下肢与硬拉", note: "深蹲、硬拉这类全身主项对 CNS 和下背压力最大，同一个动作至少隔 3 天再上大重量。" },
  { hours: "48", label: "上肢推拉主项", note: "负重引体、推举、臂屈伸，3–5 RM 且不力竭，隔 2 天基本能恢复。" },
  { hours: "48", label: "指力与悬垂等长", note: "肌腱血供比肌肉少，恢复更慢。指力板或高强度抱石之后，手指至少歇 2 天。" },
  { hours: "48", label: "VO2 max 间歇", note: "心率推到 85%–90% HRmax 的间歇，隔 2 天再做；中间可以快走或轻松骑车。" },
];

const timeline = [
  { day: "Day 0", title: "练完大重量深蹲", text: "当天补足蛋白质和睡眠，不再加练充血动作。" },
  { day: "Day 1", title: "腿不上大重量", text: "可以练上肢推拉，或只做 20–30 分钟快走、活动度。" },
  { day: "Day 2", title: "还是先放过腿", text: "可以抱石或做间歇；腿部只做轻松的活动，不做主项。" },
  { day: "Day 3", title: "可以再蹲", text: "热身重量感觉轻快，就按阶梯继续；感觉沉，就再歇一天。" },
];

const redlines = [
  {
    tag: "训练红线",
    danger: true,
    title: "不要在最后加练充血孤立动作",
    text: "主项练完觉得还有精力，也不要去抓哑铃做 3 组 × 12 次力竭的弯举、飞鸟或腿屈伸找酸胀感。最后 10 分钟的充血力竭，就足以诱发肌浆水肿，还会透支 CNS 的恢复。",
    links: [],
  },
  {
    tag: "营养与控痘",
    title: "不用普通乳清蛋白和高糖增肌粉",
    text: "我的乳糖不耐受是 Higher Tendency。乳制品和高升糖负荷会推高 insulin 与 IGF-1，可能让皮脂分泌变旺、出油冒痘。所以我用植物分离蛋白和无糖代餐，每天早上 5 g creatine monohydrate（不做 20 g 冲击期）。",
    links: [
      { label: "Soluxe 植物蛋白", href: "/stack/diet#soluxe-pea-original" },
      { label: "No Nasties Complete Meal", href: "/stack/diet#no-nasties-complete-meal" },
      { label: "Just Creatine", href: "/stack/diet#no-nasties-just-creatine" },
    ],
  },
  {
    tag: "关节与结缔组织",
    title: "用胶原原料匹配神经爆发力",
    text: "针对 Collagen Integrity 偏低（COL1A1 CC / COL3A1 AA），力量涨得越快，越要同步强化肌腱。我每天早餐固定加 10 g 胶原（补 glycine 与 proline）和维生素 C + 锌。",
    links: [
      { label: "Lennox Collagen 5000", href: "/stack/diet#lennox-collagen" },
      { label: "VitaHealth Vitamin C with Zinc+", href: "/stack/diet#vitahealth-vitamin-c-zinc" },
    ],
  },
];

const faq = [
  {
    title: "每组只做 3–5 次、还不做到力竭，真的有效吗？",
    description: "很多人把「第二天酸痛到下不了楼」当成训练有效的指标，但酸痛反映的是代谢产物堆积和微损伤，不是力量增长。用 85% 左右的重量做 5 组 × 3–5 次、每一下都全力推起，对 CNS 和高阈值快肌纤维的募集刺激远高于轻重量做 15 次力竭。练完觉得神经清醒、全身紧实，才是这套训练最理想的状态。",
  },
  {
    title: "大重量（3–5 RM）会不会比中等重量（8–12 RM）更容易受伤？",
    description: "健身房里很多受伤发生在「中等重量做到第 11、12 次、动作已经变形」的那一下：核心稳定肌群已经累垮，负荷全砸在关节韧带上。这套方案严格守 RPE 8、组间休息 3–5 分钟，每一次动作都在神经专注、核心锁死、动作不变形的状态下完成。前提是技术先练扎实，重量循序渐进。",
  },
  {
    title: "第 4 周做 5 × 4 时，最后一组明显变慢怎么办？",
    description: "不要硬撑。如果因为出差或睡眠不足导致速度下降，当周就停在 5 × 3，或者把组数减到 4 组。永远把推起速度和动作干脆度放第一位，等神经恢复了再推进下一阶。",
  },
  {
    title: "多久能看到效果？",
    description: "前 1–2 个月是神经唤醒期：体重和围度几乎不变（原本有代谢水肿的话反而更紧致），但深蹲、引体、硬拉的重量会涨得很快。3–6 个月后进入肌丝致密期：放松时线条修长，摸起来很硬，穿修身衬衫或西装也不会有壮硕绷紧的感觉。",
  },
];
---

<MainLayout
  title={`${blogData.title} - Spark Liang`}
  description={blogData.summary}
  frontmatter={{ title: blogData.title, pubDate: blogData.pubDate, summary: blogData.summary, tags: blogData.tags }}
>
  <!-- Hero -->
  <header class="sp-wrap sp-hero sp-hero--single" style="padding-bottom:2rem">
    <div class="sp-stack">
      <a class="sp-text-link" href="/blog">← 内容中心</a>
      <p class="sp-eyebrow">{blogData.type} · 运动生理学</p>
      <h1 class="sp-h1" style="max-width:14em;font-size:clamp(2.2rem,5vw,4rem)">高密度、<em>零膨胀</em>的力量训练完整指南</h1>
      <p class="sp-lede">如果我想要肌肉密度高、有力量，但不要太大只，穿西装或修身衬衫不绷紧，能同时做到吗？可以。轻量级举重选手、攀岩和体操运动员，用的就是这套只刺激<strong>神经募集与肌原纤维</strong>、不刺激<strong>肌浆储水</strong>的系统，在锁定体重和围度的前提下，把绝对力量往上推。</p>
      <p class="sp-meta">{blogData.author} · <time datetime={blogData.pubDate.toISOString()}>{formatDate(blogData.pubDate)}</time></p>
      <Tags tags={blogData.tags} />
    </div>
  </header>

  <section class="sp-wrap" aria-label="核心参数">
    <div class="hd-stats">
      {stats.map((s) => (
        <div class="sp-card sp-card--pad">
          <span class="sp-meta">{s.label}</span>
          <strong class="hd-stat">{s.value}{s.unit && <small>{s.unit}</small>}</strong>
          <span class="sp-body" style="font-size:0.88rem">{s.note}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- 免责 -->
  <section class="sp-wrap" aria-label="免责声明" style="margin-top:2rem">
    <div class="sp-card sp-card--danger sp-card--pad" style="grid-template-columns:auto 1fr;gap:1rem;align-items:start">
      <span style="display:grid;place-items:center;width:2.75rem;height:2.75rem;border-radius:50%;background:var(--sp-danger);color:#fff">
        <Icon name="alert" class="w-6 h-6" />
      </span>
      <div class="sp-stack" style="gap:0.5rem">
        <p class="sp-eyebrow sp-eyebrow--danger">个人经验，不是医疗建议</p>
        <ul class="sp-check" style="color:var(--sp-ink)">
          <li>这是我根据自己的基因报告和训练经验整理的方案，不是教练处方。基因相关的部分只适用于我，你的情况可能完全不同。</li>
          <li>大重量训练前先把动作技术练扎实；有高血压、心血管问题或关节韧带旧伤，先问医生或物理治疗师。</li>
          <li>我不会私信卖任何产品给你。有人用“Spark 推荐”的名义私信你卖货，都是假冒。</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 目录 -->
  <nav class="sp-wrap sp-section sp-section--tight" aria-label="本文目录" style="border-bottom:0">
    <ol class="sp-layers hd-toc">
      {toc.map((t) => (
        <li><a href={`#${t.id}`}><span class="sp-meta">{t.num}</span><strong>{t.title}</strong><span class="sp-layers__metaphor">{t.note}</span></a></li>
      ))}
    </ol>
  </nav>

  <!-- 01 机制 -->
  <section class="sp-wrap sp-section sp-section--alt hd-anchor" id="mechanism" aria-labelledby="mechanism-title">
    <SectionIntro
      id="mechanism-title"
      eyebrow="01 · 底层机制"
      title="为什么<em>有力量</em>不等于大块头？"
