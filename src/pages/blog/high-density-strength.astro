  <!-- 02 铁律 -->
  <section class="sp-wrap sp-section hd-anchor" id="rules" aria-labelledby="rules-title">
    <SectionIntro
      id="rules-title"
      eyebrow="02 · 五大铁律"
      title="练出高密度、零膨胀的<em>五条规矩</em>"
      copy="核心只有一句话：只刺激神经系统和肌原纤维（收缩蛋白），不刺激肌浆（储水储糖的空间）。"
    />
    <ol class="hd-rules">
      {rules.map((r, i) => (
        <li class="sp-card sp-card--pad-lg">
          <div class="hd-rules__head">
            <span class="sp-chapter__num" style="font-size:clamp(2.4rem,5vw,3.4rem)">{String(i + 1).padStart(2, "0")}</span>
            <div class="sp-stack" style="gap:0.35rem">
              <span class="sp-meta">{r.tag}</span>
              <span class="sp-tag" style="width:fit-content;font-family:var(--sp-font-mono)">{r.spec}</span>
            </div>
          </div>
          <h3 class="sp-h3">{r.title}</h3>
          <p class="sp-body">{r.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- 03 对照表 -->
  <section class="sp-wrap sp-section sp-section--alt hd-anchor" id="compare" aria-labelledby="compare-title">
    <SectionIntro id="compare-title" eyebrow="03 · 全景对照" title="高密度力量 vs. 传统显壮增肌" />
    <div class="sp-schedule">
      <table class="hd-table">
        <thead>
          <tr>
            <th scope="col">训练维度</th>
            <th scope="col" class="hd-table__good">高密度 / 零膨胀<br /><span>体操、攀岩、格斗体态</span></th>
            <th scope="col" class="hd-table__bad">传统增肌 / 显壮<br /><span>健美 bulky 体态</span></th>
          </tr>
        </thead>
        <tbody>
          {compare.map(([dim, good, bad]) => (
            <tr><th scope="row">{dim}</th><td class="hd-table__good">{good}</td><td>{bad}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- 04 进阶 -->
  <section class="sp-wrap sp-section hd-anchor" id="progression" aria-labelledby="progression-title">
    <SectionIntro
      id="progression-title"
      eyebrow="04 · 零膨胀渐进超负荷"
      title="体积不变，新的力量<em>从哪来？</em>"
      copy="不靠「练到酸痛、吃胖长粗」，力量照样能持续上升。靠的是身体内部三项硬件升级，加上 step loading（3 → 5 阶梯蓄力法）。"
    />

    <ol class="sp-flow" style="grid-template-columns:repeat(3,minmax(0,1fr))" aria-label="三项硬件升级">
      {upgrades.map((u, i) => (
        <li class={i === upgrades.length - 1 ? "is-last" : ""}>
          <span class="sp-meta">升级 {String(i + 1).padStart(2, "0")}</span>
          <strong style="font-family:var(--sp-font-display);font-size:1.1rem">{u.title}</strong>
          <span style="font-size:0.92rem;font-weight:400">{u.text}</span>
        </li>
      ))}
    </ol>

    <div class="sp-card sp-card--pad-lg sp-card--heavy hd-calc" style="gap:1.5rem">
      <div class="hd-calc__head">
        <div class="sp-stack" style="gap:0.5rem">
          <p class="sp-eyebrow">互动工具</p>
          <h3 class="sp-h3" style="font-size:clamp(1.4rem,2.6vw,2rem)">8 周阶梯蓄力计算器</h3>
          <p class="sp-body">输入你现在能标准完成 5 组 × 3 次（RPE 8，留 2 次余力）的工作重量，自动算出整个周期。</p>
        </div>
        <div class="hd-calc__controls">
          <label class="sp-field">
            <span class="sp-label">主项动作</span>
            <select id="calc-lift" class="sp-input">
              {lifts.map((l) => <option value={l.weight}>{l.label}</option>)}
            </select>
          </label>
          <label class="sp-field">
            <span class="sp-label">起始重量（kg）</span>
            <input id="calc-weight" class="sp-input" type="number" inputmode="decimal" min="0" max="300" step="2.5" value="60" />
          </label>
          <label class="sp-field">
            <span class="sp-label">达标后加重</span>
            <select id="calc-inc" class="sp-input">
              <option value="2.5">+2.5 kg（上肢 / 稳健）</option>
              <option value="5">+5 kg（下肢）</option>
            </select>
          </label>
        </div>
      </div>

      <ol class="hd-stages" aria-live="polite">
        {stages.map((s) => (
          <li class={`hd-stage ${s.kind ? `hd-stage--${s.kind}` : ""}`}>
            <span class="sp-meta">{s.weeks} · {s.name}</span>
            <strong class="hd-stage__kg" id={`calc-${s.id}`}>—</strong>
            <span class="hd-stage__scheme">{s.scheme}</span>
            <p>{s.note}</p>
          </li>
        ))}
      </ol>

      <div class="sp-mine" style="background:var(--sp-alt)">
        <p class="sp-eyebrow">速度也是进步</p>
        <p>根据 F = m × a，第 1–6 周重量（m）没变，但只要推起的加速度（a）越来越快，你输出的力量（F）其实已经上升了。每 4–6 周做一次 deload。</p>
      </div>
    </div>
  </section>

  <!-- 05 案例示范 -->
  <section class="sp-wrap sp-section sp-section--alt hd-anchor" id="recovery" aria-labelledby="recovery-title">
    <SectionIntro
      id="recovery-title"
      eyebrow="05 · 案例示范"
      title="一次课怎么练，<em>练完歇几天？</em>"
      copy="不给固定课表，只拿一次下肢课当例子，示范前面的铁律落地是什么样子，以及练完之后要等多久才能再练同一个部位。"
    />

    <div class="hd-day">
      <div class="sp-section__bar" style="flex-wrap:wrap;align-items:start">
        <div class="sp-stack" style="gap:0.4rem">
          <p class="sp-eyebrow">案例 1 · 一次下肢课</p>
          <h3 class="sp-h3" style="font-size:clamp(1.35rem,2.4vw,1.8rem)">主项 + 爆发 + 等长，三个动作就够</h3>
        </div>
        <span class="sp-tag">约 45 分钟</span>
      </div>
      <div class="sp-grid sp-grid--3">
        {sample.map((m) => (
          <div class="sp-card sp-card--pad">
            <div class="hd-move__top"><span class="sp-meta">{m.slot}</span><span class="sp-meta">{m.rest}</span></div>
            <strong style="font-family:var(--sp-font-display);font-size:1.15rem;line-height:1.3">{m.name}</strong>
            <span class="sp-cell sp-cell--hot" style="width:fit-content;white-space:normal">{m.dose}</span>
            <p class="sp-body" style="font-size:0.92rem">{m.note}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="hd-day">
      <div class="sp-stack" style="gap:0.4rem">
        <p class="sp-eyebrow">案例 2 · 练完要歇多久</p>
        <h3 class="sp-h3" style="font-size:clamp(1.35rem,2.4vw,1.8rem)">同一个部位、同一种强度，大约隔这么久</h3>
      </div>
      <div class="hd-stats">
        {recovery.map((r) => (
          <div class="sp-card sp-card--pad">
            <span class="sp-meta">{r.label}</span>
            <strong class="hd-stat">{r.hours}<small>小时</small></strong>
            <span class="sp-body" style="font-size:0.88rem">{r.note}</span>
          </div>
        ))}
      </div>
      <ol class="hd-timeline" aria-label="深蹲之后的恢复示范">
        {timeline.map((t, i) => (
          <li class={i === timeline.length - 1 ? "is-ready" : ""}>
            <span class="sp-meta">{t.day}</span>
            <strong>{t.title}</strong>
            <span>{t.text}</span>
          </li>
        ))}
      </ol>
      <div class="sp-mine" style="background:var(--sp-page)">
        <p class="sp-eyebrow">怎么判断还没恢复</p>
        <p>热身重量感觉比平时重、推起速度明显变慢、前一晚睡不好、早上静息心率比平常高 5 下以上，有任何一项就多歇一天。少练一天不会退步，带着疲劳硬练才会。</p>
      </div>
    </div>

    <p class="sp-body">想看每个动作的图解，可以看 <a class="sp-text-link" href="/stack/workout">我的运动清单</a>。</p>
  </section>

  <!-- 06 红线 -->
  <section class="sp-wrap sp-section hd-anchor" id="redlines" aria-labelledby="redlines-title">
    <SectionIntro
      id="redlines-title"
      eyebrow="06 · 执行红线"
      title="三条红线：<em>皮肤</em>和肌腱都要顾"
      copy="这部分和我的饮食与保健品清单直接联动，目的是不爆痘、不浮肿、不伤关节。"
    />
    <div class="sp-grid sp-grid--3">
      {redlines.map((r) => (
        <div class={`sp-card sp-card--pad ${r.danger ? "sp-card--danger" : ""}`}>
          <p class={`sp-eyebrow ${r.danger ? "sp-eyebrow--danger" : ""}`}>{r.tag}</p>
          <h3 class="sp-h3">{r.title}</h3>
          <p class="sp-body">{r.text}</p>
          {r.links.length > 0 && (
            <div class="sp-zones__products" style="padding-left:0">
              {r.links.map((l) => <a href={l.href}>{l.label}</a>)}
            </div>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- 07 FAQ -->
  <section class="sp-wrap sp-section sp-section--alt" aria-labelledby="faq-title">
    <SectionIntro id="faq-title" eyebrow="常见问题" title="练之前大家最常问的" />
    <div><Accordion items={faq} /></div>
  </section>

  <CtaCard
    eyebrow="下一步"
    title="想看动作怎么做？"
    copy="原理和案例讲完了，动作细节在我的运动清单里：每个动作都有图解、负荷、组次数和休息时间。"
    cta="打开运动清单"
    href="/stack/workout"
  />
</MainLayout>

<style>
  .hd-anchor { scroll-margin-top: 5rem; }
  .hd-toc { grid-template-columns: repeat(6, minmax(0, 1fr)); }

  .hd-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--sp-gap); }
  .hd-stat { font-family: var(--sp-font-display); font-size: clamp(1.8rem, 3.4vw, 2.6rem); font-weight: 900; line-height: 1; }
  .hd-stat small { margin-left: 0.3rem; font-size: 0.45em; color: var(--sp-accent-text); }

  /* 机制切换 */
  .hd-switch { display: flex; flex-wrap: wrap; gap: 0.5rem; width: fit-content; max-width: 100%; border: var(--sp-border); border-radius: calc(var(--sp-radius) + 0.25rem); padding: 0.3rem; background: var(--sp-alt); }
  .hd-switch__btn { border: 1.5px solid transparent; border-radius: var(--sp-radius); padding: 0.6rem 1rem; background: transparent; color: var(--sp-soft); font: 800 0.95rem var(--sp-font-display); cursor: pointer; }
  .hd-switch__btn[aria-selected="true"] { border-color: var(--sp-ink); background: var(--sp-accent); color: var(--sp-on-accent); box-shadow: 3px 3px 0 var(--sp-ink); }
  .hd-switch__btn[data-mode="bulky"][aria-selected="true"] { background: var(--sp-danger); }

  .hd-mode { display: grid; grid-template-columns: minmax(14rem, 0.8fr) minmax(0, 1.2fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  .hd-cell { display: grid; gap: 0.75rem; justify-items: center; margin: 0; border: var(--sp-border); border-radius: var(--sp-radius); padding: 1.5rem; background: var(--sp-alt); }
  .hd-cell__svg { width: 100%; max-width: 15rem; }
  .hd-mode[data-mode="density"] .hd-cell__svg--bulky,
  .hd-mode[data-mode="bulky"] .hd-cell__svg--density { display: none; }
  .hd-mode[data-mode="bulky"] .hd-mode__tag { border-color: var(--sp-danger); color: var(--sp-danger); }
  .hd-mode__tag { width: fit-content; }
  .hd-pulse { transform-origin: 120px 120px; animation: hd-pulse 1.8s ease-in-out infinite; }
  @keyframes hd-pulse { 50% { transform: scale(0.9); opacity: 0.6; } }

  /* 铁律 */
  .hd-rules { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-gap); }
  .hd-rules li:last-child { grid-column: 1 / -1; border-left: 6px solid var(--sp-accent); }
  .hd-rules__head { display: flex; align-items: center; gap: 1rem; }

  /* 对照表 */
  .hd-table { width: 100%; min-width: 38rem; border-collapse: collapse; font-size: 0.92rem; }
  .hd-table th, .hd-table td { padding: 0.9rem 1rem; border-bottom: 1px solid var(--sp-line); text-align: left; vertical-align: top; line-height: 1.6; }
  .hd-table thead th { background: var(--sp-alt); font-family: var(--sp-font-display); font-size: 1rem; }
  .hd-table thead th span { font-family: var(--sp-font-mono); font-size: 0.72rem; color: var(--sp-soft); font-weight: 700; }
  .hd-table thead th.hd-table__bad { color: var(--sp-danger); }
  .hd-table tbody th { white-space: nowrap; font-weight: 800; }
  .hd-table tbody td { color: var(--sp-soft); }
  .hd-table td.hd-table__good { color: var(--sp-ink); font-weight: 500; background: color-mix(in srgb, var(--sp-accent) 7%, var(--sp-page)); }
  .hd-table thead th.hd-table__good { background: var(--sp-accent); color: var(--sp-on-accent); }
  .hd-table thead th.hd-table__good span { color: rgba(255, 255, 255, 0.8); }
  .hd-table tr:last-child th, .hd-table tr:last-child td { border-bottom: 0; }

  /* 计算器 */
  .hd-calc__head { display: grid; gap: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--sp-line); }
  .hd-calc__controls { display: grid; grid-template-columns: repeat(3, minmax(9rem, 1fr)); gap: 0.75rem; }
  .hd-stages { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1rem; }
  .hd-stage { display: grid; gap: 0.4rem; align-content: start; border: var(--sp-border); border-radius: var(--sp-radius); padding: 1rem; background: var(--sp-page); }
  .hd-stage p { margin: 0.4rem 0 0; padding-top: 0.6rem; border-top: 1px solid var(--sp-line); color: var(--sp-soft); font-size: 0.85rem; line-height: 1.6; }
  .hd-stage__kg { font-family: var(--sp-font-display); font-size: 1.8rem; font-weight: 900; line-height: 1.1; }
  .hd-stage__scheme { width: fit-content; border-radius: 0.5rem; padding: 0.15rem 0.5rem; background: var(--sp-alt); font-size: 0.85rem; font-weight: 700; }
  .hd-stage--deload { border-style: dashed; background: var(--sp-alt); }
  .hd-stage--next { background: var(--sp-ink); color: var(--sp-page); box-shadow: 4px 4px 0 var(--sp-accent); }
  .hd-stage--next .sp-meta, .hd-stage--next p { color: rgba(255, 255, 255, 0.72); border-color: rgba(255, 255, 255, 0.18); }
  .hd-stage--next .hd-stage__scheme { background: var(--sp-accent); color: var(--sp-on-accent); }

  /* 案例示范 */
  .hd-day { display: grid; gap: 1.5rem; }
  .hd-day + .hd-day { padding-top: 2rem; border-top: 1px solid var(--sp-line); }
  .hd-move__top { display: flex; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap; }
  .hd-timeline { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .hd-timeline li { display: grid; gap: 0.4rem; align-content: start; border: var(--sp-border); border-radius: var(--sp-radius); padding: 1rem; background: var(--sp-page); }
  .hd-timeline strong { font-family: var(--sp-font-display); font-size: 1.05rem; }
  .hd-timeline li > span:last-child { color: var(--sp-soft); font-size: 0.88rem; line-height: 1.6; }
  .hd-timeline li.is-ready { background: var(--sp-ink); color: var(--sp-page); box-shadow: 4px 4px 0 var(--sp-accent); }
  .hd-timeline li.is-ready .sp-meta, .hd-timeline li.is-ready > span:last-child { color: rgba(255, 255, 255, 0.72); }

  @media (max-width: 980px) {
    .hd-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hd-toc { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .hd-mode { grid-template-columns: 1fr; }
    .hd-stages { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hd-stage--next { grid-column: 1 / -1; }
    .hd-timeline { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 720px) {
    .hd-rules { grid-template-columns: 1fr; }
    .hd-toc { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hd-calc__controls { grid-template-columns: 1fr; }
    .hd-stages { grid-template-columns: 1fr; }
    .hd-timeline { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { .hd-pulse { animation: none; } }
</style>

<script define:vars={{ modes }}>
  // 1. 机制切换
  const panel = document.getElementById("mode-panel");
  const caps = { density: "横截面紧凑 · 收缩蛋白致密", bulky: "被 glycogen 与水撑大 · 密度偏低" };
  const switchBtns = document.querySelectorAll(".hd-switch__btn");
  function setMode(mode) {
    const m = modes[mode];
    panel.dataset.mode = mode;
    panel.querySelector(".hd-cell__cap").textContent = caps[mode];
    panel.querySelector(".hd-mode__tag").textContent = m.tag;
    panel.querySelector(".hd-mode__title").textContent = m.title;
    panel.querySelector(".hd-mode__text").textContent = m.text;
    panel.querySelector(".hd-mode__look").textContent = m.look;
    panel.querySelector(".hd-mode__who").textContent = m.who;
    switchBtns.forEach((b) => b.setAttribute("aria-selected", String(b.dataset.mode === mode)));
  }
  switchBtns.forEach((b) => b.addEventListener("click", () => setMode(b.dataset.mode)));
  setMode("density");

  // 2. 阶梯计算器
  const lift = document.getElementById("calc-lift");
  const weight = document.getElementById("calc-weight");
  const inc = document.getElementById("calc-inc");
  const fmt = (kg) => `${Number.isInteger(kg) ? kg : kg.toFixed(1)} kg`;
  function calc() {
    const base = Math.max(0, parseFloat(weight.value) || 0);
    const step = parseFloat(inc.value) || 2.5;
    const deload = Math.round(base * 0.75 * 2) / 2; // 取最近的 0.5 kg
    ["w1", "w3", "w5"].forEach((id) => (document.getElementById(`calc-${id}`).textContent = fmt(base)));
    document.getElementById("calc-w7").textContent = fmt(deload);
    document.getElementById("calc-w8").textContent = fmt(base + step);
  }
  lift.addEventListener("change", () => { weight.value = lift.value; calc(); });
  weight.addEventListener("input", calc);
  inc.addEventListener("change", calc);
  calc();

</script>
