---
import MainLayout from "../layouts/MainLayout.astro";
import PageHero from "../components/ui/PageHero.astro";
import Button from "../components/ui/Button.astro";
---

<MainLayout title="页面未找到 - Spark Liang" description="抱歉，找不到你要访问的页面。" robots={true}>
  <PageHero eyebrow="404" title="这一页不存在。" lede="链接可能写错了，或者页面已经搬家。如果是别人发给你的“Spark 官方链接”，请小心，先到防诈骗中心核对。">
    <div class="sp-actions">
      <Button href="/">回到首页</Button>
      <Button href="/fraud-prevention" variant="ghost">防诈骗中心</Button>
    </div>
  </PageHero>
</MainLayout>
