---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import Accordion from "../../components/ui/Accordion.astro";
import ContentCard from "../../components/ui/ContentCard.astro";
import Icon from "../../components/ui/Icon.astro";
import StackItem from "../../components/stack/StackItem.astro";
import ShareButtons from "../../components/stack/ShareButtons.astro";
import FaceZones from "../../components/stack/FaceZones.astro";
import { getAllContent } from "../../lib/content";
import siteData from "../../data/siteData.json";

export async function getStaticPaths() {
  const stacks = await getCollection("stacks", (s) => !s.data.draft);
  return stacks.map((s) => ({ params: { slug: s.id }, props: { stack: s } }));
}

const { stack } = Astro.props;
const d = stack.data;
const slug = stack.id;
const routine = d.kind === "routine";
const days = ["周一", "周二", "周三", "周四", "周五", "周六", "周日"];
const itemCount = d.groups.reduce((n, g) => n + g.items.length, 0);
const updated = d.updated.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" });
const related = d.relatedTag ? (await getAllContent()).filter((c) => c.tags.includes(d.relatedTag!)).slice(0, 4) : [];
const ig = siteData.socials.find((s) => s.icon === "instagram")!;
const ogImage = `/og/stack-${slug}.png`;

// 排程：七天都一样的行合并成一格；手机版按天列出其余的行
const sched = d.schedule;
const isDaily = (r: { days: string[] }) => r.days.every((x) => x === r.days[0]);
const dailyRows = sched ? sched.rows.filter(isDaily) : [];
const weeklyRows = sched ? sched.rows.filter((r) => !isDaily(r)) : [];
const byDay = days.map((day, i) => ({
  day,
  items: weeklyRows.map((r) => r.days[i]).filter(Boolean),
}));
// 区域图：把产品 id 换成名称；写错 id 时构建直接报错
const allItems = d.groups.flatMap((g) => g.items);
const zoneAreas = (d.zones?.areas ?? []).map((a) => ({
  ...a,
  products: a.products.map((id) => {
    const it = allItems.find((x) => x.id === id);
    if (!it) throw new Error(`zones 里的产品 id「${id}」在清单里找不到`);
    return { id, name: it.name };
  }),
}));
const isHot = (cell: string) => (sched?.highlight ?? []).some((k) => cell.includes(k));
---

<MainLayout
  title={`${d.title} - Spark Liang`}
  description={`${d.tagline} ${d.intro}`}
  image={{ src: ogImage, alt: d.title }}
>
  <!-- Hero -->
  <section class="sp-wrap sp-hero sp-hero--single">
    <div class="sp-stack">
      <a class="sp-text-link" href="/stack">← 我的清单</a>
      <p class="sp-eyebrow">我的清单 · {d.short}</p>
      <h1 class="sp-h1">{d.title}</h1>
      <p class="sp-lede">{d.tagline}</p>
      <p class="sp-copy">{d.intro}</p>
      <p class="sp-meta">共 {itemCount} 项 · 最后更新 {updated}</p>
      {d.priceNote && <p class="sp-body" style="font-size:0.88rem">{d.priceNote}</p>}
      <ShareButtons path={`/stack/${slug}`} title={d.title} />
    </div>
  </section>

  <!-- 医疗免责 -->
  {d.medical && (
    <section class="sp-wrap" aria-label="免责声明">
      <div class="sp-card sp-card--danger sp-card--pad" style="grid-template-columns:auto 1fr;gap:1rem;align-items:start">
        <span style="display:grid;place-items:center;width:2.75rem;height:2.75rem;border-radius:50%;background:var(--sp-danger);color:#fff">
          <Icon name="alert" class="w-6 h-6" />
        </span>
        <div class="sp-stack" style="gap:0.5rem">
          <p class="sp-eyebrow sp-eyebrow--danger">个人经验，不是医疗建议</p>
          <ul class="sp-check" style="color:var(--sp-ink)">
            {d.safety.map((s) => <li>{s}</li>)}
            <li>我不会私信卖任何产品给你。有人用“Spark 推荐”的名义私信你卖货，都是假冒。</li>
          </ul>
        </div>
      </div>
    </section>
  )}

  <!-- 原理 -->
  {d.science && (
    <section class="sp-wrap sp-section" aria-labelledby="science-title">
      <div class="sp-stack">
        <p class="sp-eyebrow">先讲原理</p>
        <h2 class="sp-h2" id="science-title">{d.science.title}</h2>
      </div>

      {d.science.flow.length > 0 && (
        <ol class="sp-flow" aria-label={d.science.title}>
          {d.science.flow.map((step, i) => (
            <li class={i === d.science!.flow.length - 1 ? "is-last" : ""}>
              <span class="sp-meta">{String(i + 1).padStart(2, "0")}</span>
              <span>{step}</span>
            </li>
          ))}
        </ol>
      )}

      <div class="sp-stack" style="max-width:46rem">
        {d.science.paragraphs.map((p) => <p class="sp-copy">{p}</p>)}
      </div>

      {d.science.analogy && (
        <aside class="sp-card sp-card--pad-lg sp-card--heavy sp-analogy">
          <p class="sp-eyebrow">比喻</p>
          <h3 class="sp-h2" style="font-size:clamp(1.6rem,3.2vw,2.4rem)">{d.science.analogy.title}</h3>
          <p class="sp-copy" style="color:var(--sp-ink);max-width:none">{d.science.analogy.text}</p>
        </aside>
      )}

      {d.science.aside && (
        <div class="sp-stack sp-transplant">
          <h3 class="sp-h2" style="font-size:clamp(1.6rem,3.2vw,2.4rem)">{d.science.aside.title}</h3>
          {d.science.aside.lead && <p class="sp-copy" style="color:var(--sp-ink);font-weight:500">{d.science.aside.lead}</p>}
          <div class="sp-grid sp-grid--2">
            <div class="sp-card sp-card--pad-lg">
              <p class="sp-eyebrow">{d.science.aside.pros.title}</p>
              {d.science.aside.pros.points.map((pt) => (
                <div class="sp-stack" style="gap:0.3rem">
                  <h4 class="sp-h3" style="font-size:1.1rem">{pt.title}</h4>
                  <p class="sp-body">{pt.text}</p>
                </div>
              ))}
            </div>
            <div class="sp-card sp-card--pad-lg sp-card--danger">
              <p class="sp-eyebrow sp-eyebrow--danger">{d.science.aside.cons.title}</p>
              {d.science.aside.cons.points.map((pt) => (
                <div class="sp-stack" style="gap:0.3rem">
                  <h4 class="sp-h3" style="font-size:1.1rem">{pt.title}</h4>
                  <p class="sp-body">{pt.text}</p>
                </div>
              ))}
            </div>
          </div>
          {d.science.aside.conclusion && (
            <div class="sp-mine"><p class="sp-eyebrow">结论</p><p>{d.science.aside.conclusion}</p></div>
          )}
        </div>
      )}

      <!-- 四层总览 -->
      <div class="sp-stack" style="gap:0.75rem">
        <p class="sp-eyebrow">{routine ? `一周分 ${d.groups.length} 类训练日` : `所以我的方案分 ${d.groups.length} 层`}</p>
        <ol class="sp-layers">
          {d.groups.map((g, i) => (
            <li>
              <a href={`#${g.id}`}>
                <span class="sp-meta">{String(i + 1).padStart(2, "0")}</span>
                <strong>{g.name.replace(/^第.层：/, "")}</strong>
                {g.metaphor && <span class="sp-layers__metaphor">{g.metaphor}</span>}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <!-- 重点区域图 -->
  {d.zones && (
    <section class="sp-wrap sp-section sp-section--alt" aria-labelledby="zones-title">
      <div class="sp-stack">
        <p class="sp-eyebrow">重点区域</p>
        <h2 class="sp-h2" id="zones-title">{d.zones.title}</h2>
        {d.zones.intro && <p class="sp-copy">{d.zones.intro}</p>}
      </div>
      <FaceZones areas={zoneAreas} />
    </section>
  )}

  <!-- 每一层 -->
  {d.groups.map((g, gi) => (
    <section id={g.id} class={`sp-wrap sp-section sp-chapter ${gi % 2 === 0 ? "sp-section--alt" : ""}`} aria-labelledby={`${g.id}-title`}>
      <header class="sp-chapter__head">
        <span class="sp-chapter__num">{String(gi + 1).padStart(2, "0")}</span>
        <h2 class="sp-h2" id={`${g.id}-title`} style="font-size:clamp(1.8rem,3.6vw,3rem)">{g.name}</h2>
        {g.metaphor && <span class="sp-tag sp-tag--accent">{routine ? g.metaphor : `比喻：${g.metaphor}`}</span>}
      </header>

      <div class="sp-chapter__body">
        {g.explain.length > 0 && (
          <div class="sp-stack">
            <p class="sp-eyebrow">{routine ? "器械和安排" : "原理"}</p>
            {g.explain.map((p) => <p class="sp-copy">{p}</p>)}
          </div>
        )}

        {g.options.length > 0 && (
          <div class="sp-stack">
            <p class="sp-eyebrow">有哪些选择</p>
            <div class="sp-grid sp-grid--3">
              {g.options.map((o) => (
                <article class={`sp-card sp-card--pad sp-option ${o.mine ? "is-mine" : ""}`}>
                  {o.mine && <span class="sp-status sp-status--必备" style="width:fit-content">我选这个</span>}
                  <h3 class="sp-h3" style="font-size:1.15rem">{o.name}</h3>
                  <dl class="sp-dl">
                    <div><dt>好处</dt><dd>{o.pros}</dd></div>
                    <div><dt>要注意</dt><dd>{o.cons}</dd></div>
                  </dl>
                </article>
              ))}
            </div>
          </div>
        )}

        {g.mine && (
          <div class="sp-mine">
            <p class="sp-eyebrow">我的情况</p>
            <p>{g.mine}</p>
          </div>
        )}

        {g.items.length > 0 && (
          <div class="sp-stack">
            <p class="sp-eyebrow">{routine ? "动作" : "我用的是"}</p>
            <div class="sp-grid sp-grid--2">
              {g.items.map((item) => <StackItem item={item} stackSlug={slug} stackTitle={d.title} kind={d.kind} />)}
            </div>
          </div>
        )}

        {(g.fit || g.skip) && (
          <div class="sp-grid sp-grid--2">
            {g.fit && (
              <div class="sp-fit">
                <p class="sp-eyebrow">适合谁</p>
                <p>{g.fit}</p>
              </div>
            )}
            {g.skip && (
              <div class="sp-fit sp-fit--skip">
                <p class="sp-eyebrow">谁不需要</p>
                <p>{g.skip}</p>
              </div>
            )}
          </div>
        )}
      </div>
    </section>
  ))}

  <!-- 执行纪律 -->
  {d.principles.length > 0 && (
    <section class="sp-wrap sp-section" aria-labelledby="principles-title">
      <div class="sp-stack">
        <p class="sp-eyebrow">执行纪律</p>
        <h2 class="sp-h2" id="principles-title">{routine ? "呼吸和休息，比练多少更重要。" : "顺序和间隔，比产品本身更重要。"}</h2>
      </div>
      <div class="sp-grid sp-grid--2">
        {d.principles.map((p, i) => (
          <article class="sp-card sp-card--pad">
            <span class="sp-meta">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="sp-h3">{p.title}</h3>
            <p class="sp-body">{p.text}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- 排程 -->
  {d.schedule && (
    <section class="sp-wrap sp-section sp-section--alt" aria-labelledby="schedule-title">
      <div class="sp-stack">
        <p class="sp-eyebrow">排程</p>
        <h2 class="sp-h2" id="schedule-title">{d.schedule.title}</h2>
      </div>
      <div class="sp-schedule sp-schedule--table">
        <table>
          <thead>
            <tr><th scope="col"></th>{days.map((day) => <th scope="col">{day}</th>)}</tr>
          </thead>
          <tbody>
            {d.schedule.rows.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                {isDaily(row) ? (
                  <td colspan="7"><span class="sp-cell">每天 · {row.days[0]}</span></td>
                ) : (
                  row.days.map((cell) => (
                    <td>{cell ? <span class={`sp-cell ${isHot(cell) ? "sp-cell--hot" : ""}`}>{cell}</span> : <span aria-label="无">·</span>}</td>
                  ))
                )}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="sp-schedule-list">
        {dailyRows.map((r) => (
          <p class="sp-card sp-card--pad" style="margin:0"><span class="sp-meta">每天{r.label}</span><strong>{r.days[0]}</strong></p>
        ))}
        <ol class="sp-card">
          {byDay.map((x) => (
            <li>
              <span class="sp-meta">{x.day}</span>
              <span>{x.items.map((c) => <span class={`sp-cell ${isHot(c) ? "sp-cell--hot" : ""}`}>{c}</span>)}</span>
            </li>
          ))}
        </ol>
      </div>
      {d.schedule.note && <p class="sp-copy">{d.schedule.note}</p>}
    </section>
  )}

  <!-- 试过但不推荐 -->
  {d.notRecommended.length > 0 && (
    <section class="sp-wrap sp-section" aria-labelledby="nope-title">
      <div class="sp-stack">
        <p class="sp-eyebrow">停用 / 暂停</p>
        <h2 class="sp-h2" id="nope-title" style="font-size:clamp(1.8rem,3.6vw,3rem)">我停用的产品</h2>
      </div>
      <ul class="sp-check">
        {d.notRecommended.map((n) => <li><span><strong style="color:var(--sp-ink)">{n.name}：</strong>{n.reason}</span></li>)}
      </ul>
    </section>
  )}

  <!-- FAQ -->
  {d.faq.length > 0 && (
    <section class="sp-wrap sp-section sp-section--alt" aria-labelledby="faq-title">
      <div class="sp-stack">
        <p class="sp-eyebrow">常见问题</p>
        <h2 class="sp-h2" id="faq-title">大家最常问我的</h2>
      </div>
      <div><Accordion items={d.faq} /></div>
    </section>
  )}

  <!-- 相关文章 -->
  {related.length > 0 && (
    <section class="sp-wrap sp-section" aria-labelledby="related-title">
      <div class="sp-stack">
        <p class="sp-eyebrow">相关文章</p>
        <h2 class="sp-h2" id="related-title" style="font-size:clamp(1.8rem,3.6vw,3rem)">延伸阅读</h2>
      </div>
      <div class="sp-grid sp-grid--2">{related.map((item) => <ContentCard item={item} />)}</div>
    </section>
  )}

  <!-- CTA -->
  <section class="sp-wrap sp-cta" aria-label="还有问题">
    <div class="sp-stack">
      <p class="sp-eyebrow">还有问题？</p>
      <h2 class="sp-h2" style="font-size:clamp(1.6rem,3.2vw,2.5rem)">来 Instagram 问我。</h2>
      <p class="sp-copy">清单会持续更新。有我没写到的问题，私信我，常被问到的会补进上面的常见问题。</p>
    </div>
    <div><a class="sp-button sp-button--primary" href={ig.url} target="_blank" rel="noopener noreferrer">去 Instagram ↗</a></div>
  </section>
</MainLayout>
