---
import MainLayout from "./MainLayout.astro";
import Tags from "../components/ui/Tags.astro";
import CtaCard from "../components/ui/CtaCard.astro";
import { formatDate } from "../utils";

export interface Props {
  title: string;
  pubDate: Date;
  author: string;
  tags: string[];
  summary: string;
  type: string;
  featured?: boolean;
}
const { title, pubDate, author, tags, summary, type } = Astro.props;
---

<MainLayout title={`${title} - Spark Liang`} description={summary} frontmatter={{ title, pubDate, summary, tags }}>
  <header class="sp-wrap sp-hero sp-hero--single" style="padding-bottom:2rem">
    <div class="sp-stack">
      <a class="sp-text-link" href="/blog">← 内容中心</a>
      <p class="sp-eyebrow">{type}</p>
      <h1 class="sp-h1" style="max-width:20em;font-size:clamp(2rem,4.6vw,3.6rem)">{title}</h1>
      <p class="sp-lede">{summary}</p>
      <p class="sp-meta">{author} · <time datetime={new Date(pubDate).toISOString()}>{formatDate(pubDate)}</time></p>
      <Tags tags={tags} />
    </div>
  </header>

  <article class="sp-wrap prose" style="max-width:48rem;padding-block:2rem 4rem;border-top:1px solid var(--sp-line)">
    <slot />
  </article>

  <CtaCard
    eyebrow="下一步"
    title="觉得这篇文章有启发？"
    copy="你可以去浏览我正在用的日常清单，去 Instagram 找我聊聊你的想法，或者了解我的官方合作机构与咨询服务。"
    cta="浏览我的清单"
    href="/stack"
  />
</MainLayout>
