---
import Seo from "../components/seo/Seo.astro";
import siteData from "../data/siteData.json";

const { title, description, image, frontmatter, robots } = Astro.props;
const pageDescription = description || siteData.description;
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <meta name="theme-color" content="#0A0A0D" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Inter:wght@400;500;700&family=Noto+Sans+SC:wght@400;500;700;900&display=swap"
  />

  <title>{title}</title>
  <meta name="description" content={pageDescription} />

  <Seo
    {title}
    description={pageDescription}
    url={Astro.url.toString()}
    {image}
    {frontmatter}
    {robots}
  />
</head>
