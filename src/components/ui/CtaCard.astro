---
import Button from "./Button.astro";
interface Props {
  eyebrow?: string;
  title?: string;
  copy?: string;
  cta?: string;
  href?: string;
}
const {
  eyebrow = "交流与合作",
  title = "想解决企业财务痛点，或探讨合作？",
  copy = "日常理财与清单交流，欢迎来 Instagram 找我；企业 AI 财务看板、预算与分钱机制咨询、企业内训及品牌媒体合作，请填写合作表单，我会在 3 个工作日内回复。",
  cta = "预约咨询 / 填写表单",
  href = "/contact#collab",
} = Astro.props;
---

<section class="sp-wrap sp-cta" aria-label={eyebrow}>
  <div class="sp-stack">
    <p class="sp-eyebrow">{eyebrow}</p>
    <h2 class="sp-h2" style="font-size:clamp(1.6rem,3.2vw,2.5rem)">{title}</h2>
    <p class="sp-copy">{copy}</p>
  </div>
  <div><Button href={href}>{cta}</Button></div>
</section>
