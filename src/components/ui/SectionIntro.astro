---
// 区块开头：眉标 → 大标题 → 说明文字
interface Props {
  eyebrow?: string;
  title: string;
  copy?: string;
  id?: string;
  danger?: boolean;
}
const { eyebrow, title, copy, id, danger = false } = Astro.props;
---

<div class="sp-stack">
  {eyebrow && <p class={`sp-eyebrow ${danger ? "sp-eyebrow--danger" : ""}`}>{eyebrow}</p>}
  <h2 class="sp-h2" id={id} set:html={title} />
  {copy && <p class="sp-copy">{copy}</p>}
  <slot />
</div>
