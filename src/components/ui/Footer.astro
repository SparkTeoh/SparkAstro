---
import nav from "../../data/nav.json";
import siteData from "../../data/siteData.json";

const year = new Date().getFullYear();
---

<footer class="sp-wrap sp-footer">
  <a class="sp-brand" href="/" style="justify-self:center">Spark Liang</a>
  <nav class="sp-footer__nav" aria-label="页脚导航">
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    {siteData.socials.map((s) => (
      <a href={s.url} target="_blank" rel="noopener noreferrer">{s.name}</a>
    ))}
  </nav>
  <p class="sp-footer__legal">
    © {year} Spark Liang. 保留所有权利。官方账号只有 Facebook、Instagram、YouTube 三个，其余均为假冒。
  </p>
</footer>
