---
type Props = { index: number; title: string; description: string };
const { index, title, description } = Astro.props;
const id = `faq-${index}-${title.length}`;
---

<div class="sp-card accordion-item" style="margin-bottom:1rem">
  <button
    type="button"
    class="accordion-toggle"
    id={`${id}-btn`}
    aria-expanded="false"
    aria-controls={`${id}-panel`}
  >
    <span class="accordion-num">{String(index).padStart(2, "0")}</span>
    <span class="sp-h3 accordion-title">{title}</span>
    <span class="accordion-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
    </span>
  </button>
  <div id={`${id}-panel`} role="region" aria-labelledby={`${id}-btn`} class="accordion-panel">
    <div><p class="sp-body">{description}</p></div>
  </div>
</div>

<style>
  .accordion-toggle {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    width: 100%;
    border: 0;
    background: transparent;
    padding: 1.25rem 1.5rem;
    text-align: left;
    cursor: pointer;
    color: var(--sp-ink);
  }
  .accordion-num {
    font-family: var(--sp-font-mono);
    font-weight: 800;
    font-size: 0.85rem;
    color: var(--sp-soft);
  }
  .accordion-icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: var(--sp-border);
    border-radius: 50%;
    background: var(--sp-page);
    transition: transform 200ms ease, background 200ms ease;
  }
  .accordion-icon svg { width: 1rem; height: 1rem; }
  .accordion-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 240ms ease;
  }
  .accordion-panel > div { overflow: hidden; padding-inline: 1.5rem 4.5rem; }
  .accordion-panel p { padding-bottom: 1.4rem; padding-left: 2.1rem; }
  .accordion-item.is-open .accordion-panel { grid-template-rows: 1fr; }
  .accordion-item.is-open .accordion-icon { transform: rotate(45deg); background: var(--sp-accent); color: var(--sp-on-accent); border-color: var(--sp-accent); }
  @media (max-width: 720px) {
    .accordion-panel > div { padding-inline: 1.25rem; }
    .accordion-panel p { padding-left: 0; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".accordion-item").forEach((item) => {
    const btn = item.querySelector<HTMLButtonElement>(".accordion-toggle");
    btn?.addEventListener("click", () => {
      const open = !item.classList.contains("is-open");
      item.parentElement?.querySelectorAll(".accordion-item.is-open").forEach((o) => {
        o.classList.remove("is-open");
        o.querySelector(".accordion-toggle")?.setAttribute("aria-expanded", "false");
      });
      item.classList.toggle("is-open", open);
      btn.setAttribute("aria-expanded", String(open));
    });
  });
</script>
