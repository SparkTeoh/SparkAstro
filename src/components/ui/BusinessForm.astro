---
// 商业合作表单：通过 Netlify Forms 收集（需在 Netlify 后台开启 Form detection）
import Button from "./Button.astro";

const input = "sp-input";
const types = [
  { id: "course", value: "课程合作", label: "课程合作" },
  { id: "brand", value: "品牌合作", label: "品牌合作" },
  { id: "education", value: "投资教育", label: "投资教育" },
  { id: "media", value: "媒体合作", label: "媒体合作" },
];
---

<form
  id="business-form"
  name="business-collaboration"
  method="POST"
  action="/contact/thanks"
  data-netlify="true"
  netlify-honeypot="bot-field"
  class="sp-stack" style="gap:1.1rem;margin-top:1rem"
>
  <input type="hidden" name="form-name" value="business-collaboration" />
  <p hidden><label>请勿填写：<input name="bot-field" /></label></p>

  <fieldset style="border:0;padding:0;margin:0">
    <legend class="sp-label" style="margin-bottom:0.5rem">合作类型 *</legend>
    <div class="sp-grid sp-grid--2" style="gap:0.6rem">
      {types.map((t, i) => (
        <label for={`type-${t.id}`} style="display:flex;align-items:center;gap:0.6rem;cursor:pointer">
          <input type="radio" id={`type-${t.id}`} name="collaboration_type" value={t.value} class="business-radio" checked={i === 0} />
          {t.label}
        </label>
      ))}
    </div>
  </fieldset>

  <div class="sp-field">
    <label for="company_name" class="sp-label">公司 / 机构名称 *</label>
    <input type="text" id="company_name" name="company_name" placeholder="请输入公司或机构名称" required class={input} />
  </div>

  <div class="sp-grid sp-grid--2" style="gap:1rem">
    <div class="sp-field">
      <label for="contact_name" class="sp-label">联系人姓名 *</label>
      <input type="text" id="contact_name" name="contact_name" placeholder="姓名" required class={input} />
    </div>
    <div class="sp-field">
      <label for="position" class="sp-label">职位</label>
      <input type="text" id="position" name="position" placeholder="职位 / 头衔" class={input} />
    </div>
  </div>

  <div class="sp-grid sp-grid--2" style="gap:1rem">
    <div class="sp-field">
      <label for="email" class="sp-label">邮箱地址 *</label>
      <input type="email" id="email" name="email" placeholder="your@email.com" required class={input} />
    </div>
    <div class="sp-field">
      <label for="phone" class="sp-label">联系电话</label>
      <input type="tel" id="phone" name="phone" placeholder="+60 12-345 6789" class={input} />
    </div>
  </div>

  <div class="sp-field">
    <label for="budget" class="sp-label">合作预算范围</label>
    <select id="budget" name="budget" class={input}>
      <option value="">请选择预算范围</option>
      <option>RM 10,000 以下</option>
      <option>RM 10,000 – 50,000</option>
      <option>RM 50,000 – 100,000</option>
      <option>RM 100,000 以上</option>
      <option>面议</option>
    </select>
  </div>

  <div class="sp-field">
    <label for="project_details" class="sp-label">项目详情 *</label>
    <textarea id="project_details" name="project_details" rows="4" required class="sp-input" style="resize:vertical"
      placeholder="请描述你的合作需求、项目背景、期望达成的目标等…"></textarea>
  </div>

  <div class="sp-grid sp-grid--2" style="gap:1rem">
    <div class="sp-field">
      <label for="start_date" class="sp-label">期望开始时间</label>
      <input type="date" id="start_date" name="start_date" class={input} />
    </div>
    <div class="sp-field">
      <label for="duration" class="sp-label">项目周期</label>
      <select id="duration" name="duration" class={input}>
        <option value="">请选择项目周期</option>
        <option>1 个月</option>
        <option>3 个月</option>
        <option>6 个月</option>
        <option>1 年</option>
        <option>长期合作</option>
        <option>其他</option>
      </select>
    </div>
  </div>

  <Button type="submit" block>提交合作申请</Button>
</form>

<style>
  .business-radio {
    appearance: none;
    width: 20px;
    height: 20px;
    border: 1.5px solid var(--sp-ink);
    border-radius: 50%;
    cursor: pointer;
    position: relative;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }
  .business-radio:hover,
  .business-radio:focus-visible {
    border-color: var(--sp-accent);
    outline: none;
  }
  .business-radio:checked {
    background-color: var(--sp-ink);
  }
  .business-radio:checked::after {
    content: "";
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: white;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }
</style>

<script>
  // 根据合作类型切换项目详情的提示文字
  const form = document.getElementById("business-form");
  const details = form?.querySelector<HTMLTextAreaElement>("#project_details");
  const hints: Record<string, string> = {
    课程合作: "例如：联合开发理财课程、客座讲师邀请、课程推广合作…",
    品牌合作: "例如：产品推广、品牌代言、联合营销活动…",
    投资教育: "例如：企业内训、投资讲座、理财咨询服务…",
    媒体合作: "例如：访谈邀请、内容创作、媒体推广…",
  };
  form?.querySelectorAll<HTMLInputElement>('input[name="collaboration_type"]').forEach((r) =>
    r.addEventListener("change", () => {
      if (r.checked && details) details.placeholder = hints[r.value] ?? details.placeholder;
    }),
  );
</script>
