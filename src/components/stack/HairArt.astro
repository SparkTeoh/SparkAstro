---
// 生发清单专用插画（无品牌、无文字）：没有产品照片的 helmet / clinic 项目用它填满左侧图区
interface Props { name: "helmet" | "clinic" }
const { name } = Astro.props;

// helmet：头盔内壁上的激光点，三圈椭圆排布
const diodes = [
  { k: 0.86, n: 9 },
  { k: 0.64, n: 7 },
  { k: 0.42, n: 5 },
].flatMap(({ k, n }) =>
  Array.from({ length: n }, (_, i) => {
    const t = ((18 + (i * 144) / (n - 1)) * Math.PI) / 180;
    return { x: 200 + 96 * k * Math.cos(t), y: 236 - 104 * k * Math.sin(t) };
  }),
);
const rays = Array.from({ length: 11 }, (_, i) => -75 + i * 15);

// clinic：微针、毛囊、外泌体、胜肽链
const needles = Array.from({ length: 8 }, (_, i) => 144 + i * 16);
const follicles = [
  { x: 82, tilt: -8, hair: "M0 0 C -4 -40 6 -70 -10 -104" },
  { x: 200, tilt: 4, hair: "M0 0 C 2 -14 -2 -22 4 -30" },
  { x: 318, tilt: 9, hair: "M0 0 C 6 -36 -6 -68 10 -100" },
];
const vesicles = [
  { x: 138, y: 196, r: 11 }, { x: 162, y: 238, r: 8 }, { x: 128, y: 272, r: 9 },
  { x: 250, y: 204, r: 9 }, { x: 268, y: 250, r: 12 }, { x: 240, y: 286, r: 7 },
  { x: 176, y: 172, r: 6 }, { x: 222, y: 168, r: 6 }, { x: 36, y: 230, r: 8 }, { x: 364, y: 226, r: 9 },
];
const beads = Array.from({ length: 13 }, (_, i) => {
  const x = 52 + i * 24.7;
  return { x, y: 356 + 14 * Math.sin(i * 0.9), kind: i % 3 };
});
const chain = beads.map((b, i) => `${i ? "L" : "M"}${b.x.toFixed(1)} ${b.y.toFixed(1)}`).join(" ");
---

<svg class={`sp-hair-art sp-hair-art--${name}`} viewBox="0 0 400 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    <pattern id={`ha-grid-${name}`} width="20" height="20" patternUnits="userSpaceOnUse">
      <path d="M20 0H0V20" class="ha-gridline" />
    </pattern>
  </defs>
  <rect width="400" height="400" class="ha-bg" />
  <rect width="400" height="400" fill={`url(#ha-grid-${name})`} />

  {name === "helmet" && (
    <g>
      <defs>
        <radialGradient id="ha-halo" cx="50%" cy="48%" r="50%">
          <stop offset="0" class="ha-red" stop-opacity="0.32" />
          <stop offset="0.55" class="ha-red" stop-opacity="0.1" />
          <stop offset="1" class="ha-red" stop-opacity="0" />
        </radialGradient>
        <linearGradient id="ha-ray" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" class="ha-red" stop-opacity="0.38" />
          <stop offset="1" class="ha-red" stop-opacity="0" />
        </linearGradient>
        <radialGradient id="ha-inner" cx="50%" cy="85%" r="70%">
          <stop offset="0" class="ha-red" stop-opacity="0.34" />
          <stop offset="1" class="ha-red" stop-opacity="0.04" />
        </radialGradient>
        <filter id="ha-blur" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="3" /></filter>
        <clipPath id="ha-dome"><path d="M104 236A96 104 0 0 1 296 236Z" /></clipPath>
      </defs>

      <circle cx="200" cy="200" r="190" fill="url(#ha-halo)" class="ha-pulse" />
      <g class="ha-rays">
        {rays.map((a) => (
          <path d="M200 200 L188 -10 L212 -10 Z" fill="url(#ha-ray)" transform={`rotate(${a} 200 200)`} />
        ))}
      </g>

      <!-- 头 + 肩：硬阴影 -->
      <g transform="translate(7 7)" class="ha-shadow">
        <path d="M84 410C92 360 140 342 172 338H228C260 342 308 360 316 410Z" />
        <ellipse cx="200" cy="246" rx="76" ry="88" />
      </g>
      <path d="M84 410C92 360 140 342 172 338H228C260 342 308 360 316 410Z" class="ha-skin" />
      <rect x="176" y="300" width="48" height="44" class="ha-skin" />
      <ellipse cx="200" cy="246" rx="76" ry="88" class="ha-skin" />

      <!-- 头盔 -->
      <path d="M104 236A96 104 0 0 1 296 236Z" class="ha-glass" />
      <g clip-path="url(#ha-dome)">
        <rect x="100" y="130" width="200" height="110" fill="url(#ha-inner)" class="ha-pulse" />
        {diodes.map((d) => (
          <path d={`M${d.x.toFixed(1)} ${d.y.toFixed(1)} L200 ${236 + 6}`} class="ha-beam" />
        ))}
      </g>
      <g filter="url(#ha-blur)" class="ha-pulse">
        {diodes.map((d) => <circle cx={d.x.toFixed(1)} cy={d.y.toFixed(1)} r="7" class="ha-glow" />)}
      </g>
      {diodes.map((d) => <circle cx={d.x.toFixed(1)} cy={d.y.toFixed(1)} r="3.2" class="ha-diode" />)}
      <path d="M104 236A96 104 0 0 1 296 236" class="ha-outline" />
      <path d="M98 232H302V250Q200 266 98 250Z" class="ha-rim" />
      <path d="M118 140Q150 112 196 108" class="ha-shine" />
    </g>
  )}

  {name === "clinic" && (
    <g>
      <!-- 皮肤剖面 -->
      <path d="M-10 132C60 118 120 144 200 130S340 120 410 132V410H-10Z" class="ha-skin" />
      <path d="M-10 160C70 148 130 170 200 158S330 148 410 160" class="ha-layer" />
      <path d="M-10 132C60 118 120 144 200 130S340 120 410 132" class="ha-outline" />

      <!-- 微针 + 针孔通道 -->
      <g transform="translate(6 6)" class="ha-shadow"><rect x="130" y="34" width="140" height="22" rx="4" /></g>
      <rect x="130" y="34" width="140" height="22" rx="4" class="ha-plate" />
      {needles.map((x) => <path d={`M${x - 3} 56L${x} 104L${x + 3} 56Z`} class="ha-needle" />)}
      {needles.map((x) => (
        <g>
          <circle cx={x} cy={131 - Math.sin((x - 130) / 30) * 2} r="2.4" class="ha-dot" />
          <path d={`M${x} 140V176`} class="ha-channel" />
        </g>
      ))}

      <!-- 毛囊 -->
      {follicles.map((f) => (
        <g transform={`translate(${f.x} 132) rotate(${f.tilt})`}>
          <path d="M-12 0C-14 60-16 110-22 150C-26 178 26 178 22 150C16 110 14 60 12 0Z" class="ha-sheath" />
          <ellipse cx="0" cy="160" rx="10" ry="8" class="ha-papilla" />
          <path d="M0 152V0" class="ha-shaft" />
          <path d={f.hair} class="ha-shaft" />
        </g>
      ))}

      <!-- 外泌体 -->
      {vesicles.map((v) => (
        <g>
          <circle cx={v.x} cy={v.y} r={v.r} class="ha-vesicle" />
          <circle cx={v.x} cy={v.y} r={v.r - 3.5} class="ha-vesicle-in" />
          <circle cx={v.x - v.r * 0.3} cy={v.y - v.r * 0.3} r="1.6" class="ha-dot" />
        </g>
      ))}

      <!-- 胜肽链 -->
      <path d={chain} class="ha-chain" />
      {beads.map((b, i) => i % 2 === 0 && (
        <path d={`M${b.x.toFixed(1)} ${b.y.toFixed(1)}l${i % 4 ? 8 : -8} -16`} class="ha-chain" />
      ))}
      {beads.map((b) => <circle cx={b.x.toFixed(1)} cy={b.y.toFixed(1)} r="8" class={`ha-bead ha-bead--${b.kind}`} />)}
    </g>
  )}
</svg>

<style>
  .sp-hair-art {
    display: block;
    place-self: stretch;
    width: 100%;
    height: 100%;
  }
  .ha-bg { fill: var(--sp-alt); }
  .ha-gridline { fill: none; stroke: var(--sp-grid); stroke-width: 1; }
  .ha-red { stop-color: var(--sp-danger); }
  .ha-shadow { fill: var(--sp-ink); }
  .ha-skin { fill: var(--sp-page); stroke: var(--sp-ink); stroke-width: 3; stroke-linejoin: round; }
  .ha-outline { fill: none; stroke: var(--sp-ink); stroke-width: 3; stroke-linecap: round; }
  .ha-dot { fill: var(--sp-ink); }

  /* helmet */
  .ha-glass { fill: var(--sp-page); fill-opacity: 0.55; }
  .ha-beam { stroke: var(--sp-danger); stroke-width: 1.5; stroke-opacity: 0.28; stroke-linecap: round; }
  .ha-glow { fill: var(--sp-danger); opacity: 0.55; }
  .ha-diode { fill: var(--sp-danger); stroke: var(--sp-ink); stroke-width: 1.2; }
  .ha-rim { fill: var(--sp-ink); }
  .ha-shine { fill: none; stroke: var(--sp-page); stroke-width: 5; stroke-linecap: round; opacity: 0.9; }

  /* clinic */
  .ha-layer { fill: none; stroke: var(--sp-line); stroke-width: 2; stroke-dasharray: 2 6; stroke-linecap: round; }
  .ha-plate { fill: var(--sp-page); stroke: var(--sp-ink); stroke-width: 3; }
  .ha-needle { fill: var(--sp-ink); }
  .ha-channel { stroke: var(--sp-ink); stroke-width: 2; stroke-dasharray: 1 6; stroke-linecap: round; opacity: 0.45; }
  .ha-sheath { fill: var(--sp-alt); stroke: var(--sp-ink); stroke-width: 2.5; }
  .ha-papilla { fill: var(--sp-accent); stroke: var(--sp-ink); stroke-width: 2; }
  .ha-shaft { fill: none; stroke: var(--sp-ink); stroke-width: 3.5; stroke-linecap: round; }
  .ha-vesicle { fill: var(--sp-accent); fill-opacity: 0.14; stroke: var(--sp-accent); stroke-width: 2.5; }
  .ha-vesicle-in { fill: none; stroke: var(--sp-accent); stroke-width: 1.2; stroke-dasharray: 2 3; }
  .ha-chain { fill: none; stroke: var(--sp-ink); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .ha-bead { stroke: var(--sp-ink); stroke-width: 2.5; }
  .ha-bead--0 { fill: var(--sp-accent); }
  .ha-bead--1 { fill: var(--sp-page); }
  .ha-bead--2 { fill: var(--sp-ink); }

  @media (prefers-reduced-motion: no-preference) {
    .ha-pulse { animation: ha-pulse 3.2s ease-in-out infinite; }
    @keyframes ha-pulse { 50% { opacity: 0.6; } }
  }
</style>
