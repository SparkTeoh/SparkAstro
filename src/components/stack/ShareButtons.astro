---
// 复制链接 + WhatsApp 分享。path 为站内路径（可带 #id），title 用于分享文字。
interface Props { path: string; title: string }
const { path, title } = Astro.props;
---

<span style="display:inline-flex;gap:0.5rem;flex-wrap:wrap">
  <button type="button" class="sp-icon-btn js-copy-link" data-path={path} aria-label={`复制「${title}」的链接`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M10 13a5 5 0 007.07 0l3-3a5 5 0 00-7.07-7.07l-1 1M14 11a5 5 0 00-7.07 0l-3 3a5 5 0 007.07 7.07l1-1"/></svg>
    <span class="js-copy-label">复制链接</span>
  </button>
  <a class="sp-icon-btn js-wa-share" data-path={path} data-title={title} href="https://wa.me/" target="_blank" rel="noopener noreferrer" aria-label={`用 WhatsApp 分享「${title}」`}>
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2zm0 18.2a8.2 8.2 0 01-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1112 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 01-3.3-2.9c-.2-.4.2-.4.7-1.3a.4.4 0 000-.4l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 00-.7.3 3 3 0 00-.9 2.2 5.2 5.2 0 001.1 2.7 11.8 11.8 0 004.5 4c1.7.7 2.4.8 3.2.7a2.8 2.8 0 001.8-1.3 2.3 2.3 0 00.2-1.3c-.1-.1-.2-.2-.5-.3z"/></svg>
    WhatsApp
  </a>
</span>

<script>
  document.querySelectorAll<HTMLButtonElement>(".js-copy-link").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const url = new URL(btn.dataset.path ?? "/", location.origin).toString();
      const label = btn.querySelector(".js-copy-label");
      try {
        await navigator.clipboard.writeText(url);
        if (label) label.textContent = "已复制 ✓";
      } catch {
        window.prompt("复制这个链接：", url);
      }
      setTimeout(() => { if (label) label.textContent = "复制链接"; }, 1800);
    });
  });
  document.querySelectorAll<HTMLAnchorElement>(".js-wa-share").forEach((a) => {
    const url = new URL(a.dataset.path ?? "/", location.origin).toString();
    a.href = `https://wa.me/?text=${encodeURIComponent(`${a.dataset.title} ${url}`)}`;
  });
</script>
