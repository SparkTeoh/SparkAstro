---
// 原创的产品类型线条图标（无品牌），在没有产品照片时显示
interface Props { name?: "dropper" | "foam" | "shampoo" | "helmet" | "stamp" | "clinic" }
const { name } = Astro.props;
---

<svg viewBox="0 0 120 120" class="sp-product-icon" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "dropper" && (
    <g>
      <rect x="40" y="52" width="40" height="52" rx="8" />
      <path d="M48 52v-8h24v8" />
      <rect x="52" y="20" width="16" height="24" rx="8" class="sp-fill" />
      <path d="M50 74h20M50 84h14" />
    </g>
  )}
  {name === "foam" && (
    <g>
      <rect x="38" y="40" width="44" height="66" rx="10" />
      <path d="M48 40v-10h24v10" />
      <path d="M60 30V20h18" />
      <circle cx="88" cy="18" r="4" class="sp-fill" />
      <circle cx="96" cy="26" r="3" class="sp-fill" />
      <path d="M48 64h24" />
    </g>
  )}
  {name === "shampoo" && (
    <g>
      <path d="M42 46c0-6 4-10 10-10h16c6 0 10 4 10 10v52a8 8 0 01-8 8H50a8 8 0 01-8-8z" />
      <path d="M52 36v-8h16v8" />
      <path d="M56 28v-8h20" />
      <rect x="50" y="60" width="20" height="24" rx="3" class="sp-fill" />
    </g>
  )}
  {name === "helmet" && (
    <g>
      <path d="M22 76a38 38 0 0176 0v8H22z" />
      <path d="M22 84h76" />
      {[36, 48, 60, 72, 84].map((x) => <circle cx={x} cy="66" r="3" class="sp-fill" />)}
      {[42, 54, 66, 78].map((x) => <circle cx={x} cy="54" r="3" class="sp-fill" />)}
      <path d="M60 100v-16" />
    </g>
  )}
  {name === "stamp" && (
    <g>
      <rect x="54" y="16" width="12" height="54" rx="6" />
      <path d="M44 70h32v10H44z" class="sp-fill" />
      {[48, 54, 60, 66, 72].map((x) => <path d={`M${x} 80v10`} />)}
      <path d="M36 102h48" />
    </g>
  )}
  {name === "clinic" && (
    <g>
      <path d="M30 90l44-44" />
      <rect x="64" y="22" width="18" height="44" rx="4" transform="rotate(45 73 44)" />
      <path d="M86 18l16 16M94 26l-8 8" />
      <path d="M30 90l-8 8" />
      <path d="M24 30h16M32 22v16" class="sp-accent-stroke" />
    </g>
  )}
  {!name && <circle cx="60" cy="60" r="30" />}
</svg>
